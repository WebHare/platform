<?wh
LOADLIB "wh::files.whlib";
LOADLIB "wh::internet/urls.whlib";
LOADLIB "wh::xml/dom.whlib";

/*
GuessFromCode() is a replacement for:
  - GetVimeoMovieIdByText()
  - GetYouTubeMovieCodeFromURL()
  - GetYouTubeMovieCodeFromText()
*/


/** @short Parse a start time as used by YouTube and Vimeo URLs
    @param timestr Time, eg "90", "90s", "2m", "1m30s" or "1h2m3s". A number without a unit is in seconds
    @return The time in seconds, 0 if it couldn't be parsed */
INTEGER FUNCTION ParseTimeOffset(STRING timestr) {
  timestr := ToLowercase(TrimWhitespace(timestr));
  INTEGER total;
  STRING digits;
  FOR(INTEGER i := 0; i < Length(timestr); i := i + 1) {
    STRING ch := Substring(timestr, i, 1);
    IF(ch >= "0" AND ch <= "9") {
      digits := digits || ch;
      IF(Length(digits) > 5) //more than 99999 hours, minutes or seconds isn't a sensible start time (and could overflow)
        RETURN 0;
      CONTINUE;
    }

    INTEGER multiplier := ch = "h" ? 3600 : (ch = "m" ? 60 : (ch = "s" ? 1 : 0));
    IF(multiplier = 0 OR digits = "") //unknown unit or a unit without a number
      RETURN 0;

    total := total + ToInteger(digits, 0) * multiplier;
    digits := "";
  }
  RETURN total + ToInteger(digits, 0); //a trailing number without unit is in seconds
}

// NOTE: we ignore the fact not all YouTube url types support both start or t, or which takes precedence
INTEGER FUNCTION ParseYoutubeStarttime(STRING text)
{
  RETURN ParseTimeOffset(GetVariableFromURL(text, "start") ?? GetVariableFromURL(text, "t"));
}

/** @short Parse the start time from a Vimeo URL (#t=1m30s) */
INTEGER FUNCTION ParseVimeoStarttime(STRING text) {
  INTEGER hashpos := SearchSubstring(text, "#");
  IF(hashpos = -1)
    RETURN 0;

  STRING fragment := Substring(text, hashpos + 1, Length(text));
  RETURN fragment LIKE "t=*" ? ParseTimeOffset(Substring(fragment, 2, Length(fragment))) : 0;
}

BOOLEAN FUNCTION IsVimeoVideoId(STRING part) {
  RETURN part != "" AND ToInteger64(part, -1) > 0; //Vimeo ids will soon no longer fit in 32 bits
}

/** @short Is this the privacy hash of an unlisted Vimeo video? (10 lowercase hex characters) */
BOOLEAN FUNCTION IsVimeoUnlistedHash(STRING part) {
  IF(Length(part) != 10)
    RETURN FALSE;
  FOR(INTEGER i := 0; i < 10; i := i + 1) {
    STRING ch := Substring(part, i, 1);
    IF(NOT ((ch >= "0" AND ch <= "9") OR (ch >= "a" AND ch <= "f")))
      RETURN FALSE;
  }
  RETURN TRUE;
}

/** @short Split a Vimeo video id as stored in a video embed ("<id>", or "<id>/<hash>" for unlisted videos)
    @param videoid Video id
    @return The parsed id, DEFAULT RECORD if it's not a valid Vimeo video id
    @cell(string) return.id Numeric video id
    @cell(string) return.hash Privacy hash of an unlisted video, empty for other videos */
PUBLIC RECORD FUNCTION ParseVimeoVideoId(STRING videoid) {
  STRING ARRAY parts := Tokenize(videoid, "/");
  IF(Length(parts) NOT IN [1, 2] OR NOT IsVimeoVideoId(parts[0]) OR (Length(parts) = 2 AND NOT IsVimeoUnlistedHash(parts[1])))
    RETURN DEFAULT RECORD;

  RETURN CELL[ id := parts[0], hash := Length(parts) = 2 ? parts[1] : "" ];
}

/** @short Get the vimeo.com URL for a video parsed by ParseVimeoVideoId */
PUBLIC STRING FUNCTION GetVimeoVideoURL(RECORD parsed) {
  RETURN "https://vimeo.com/" || parsed.id || (parsed.hash != "" ? "/" || parsed.hash : "");
}

/** @short remove arguments and hash from the urlpath
           (just as in Javascript/DOM window.location.pathname)
*/
STRING FUNCTION __GetPathName(STRING urlpath)
{
  INTEGER hashstart := SearchSubstring(urlpath,'#');
  IF(hashstart!=-1)
    urlpath := Left(urlpath,hashstart);

  INTEGER paramstart := SearchSubstring(urlpath,'?');
  IF(paramstart!=-1)
    urlpath := Left(urlpath,paramstart);
  ELSE
  {
    // This is but of a weird URL, but let's clean it up anyway
    paramstart := SearchSubstring(urlpath,'&');
    IF(paramstart!=-1)
      urlpath := Left(urlpath,paramstart);
  }

  RETURN urlpath;
}

/** @short Tries to determine network and videoid from the specified URL
           (currently supports YouTube and Vimeo)
    @param url A valid URL (either http or https)
    @return Information on the movie (or DEFAULT RECORD if parsing failed)
    @return.network The network on which the video resides
    @return.id The id of the video
*/
PUBLIC RECORD FUNCTION GuessFromCode(STRING text)
{
  text := TrimWhiteSpace(text);
  IF (text = "")
    RETURN DEFAULT RECORD;

  // hack in case we get an iframe embed code
  IF (text LIKE "<iframe*")
  {
    //add div around incase there is extra html after the iframe
    OBJECT iframe := MakeXMLDocumentFromHTML(StringToBlob('<div>' || text || '</div>'))->GetElementsByTagName("iframe");
    IF (iframe->Length > 0)
      text := iframe->Item(0)->GetAttribute('src');
  }

  // no protocol specified?
  // then assume https:// so unpackURL gets a valid URL
  IF (text LIKE '//*')
    text := 'https:' || text;
  ELSE IF (SearchSubstring(text, "://") = -1)
    text := "https://" || text;

  RECORD unpacked := UnpackURL(text);

  /*
  DumpValue(unpacked, "tree");
  PRINT("\n");
  */
  IF (unpacked.scheme NOT IN ["http","https"])
    RETURN DEFAULT RECORD;

  STRING host_lc := ToLowerCase(unpacked.host);
  //RECORD urlparts = SplitURLForVars(text); // [ baseurl := "", vars := "", hash := "" ]
  STRING pathname := __GetPathname(unpacked.urlpath); // like JS pathname (without searchquery and hash part)

  IF(host_lc LIKE '*.vimeo.com' OR host_lc = 'vimeo.com')
  {
    STRING ARRAY parts;
    FOREVERY(STRING part FROM Tokenize(pathname, '/'))
      IF(part != '')
        INSERT part INTO parts AT END;

    /* Unlisted videos need their privacy hash, which can be in the path (vimeo.com/<id>/<hash>,
       player.vimeo.com/video/<id>/<hash>, vimeo.com/<user>/review/<id>/<hash>) or in the 'h' parameter
       (player.vimeo.com/video/<id>?h=<hash>). So if the path ends in an id and a hash, take both. Hashes can be
       all digits (eg vimeo.com/581039021/9603038895), so we can't tell a hash from a video id. Except in
       vimeo.com/channels/<channel>/<id>, where a numeric channel would look like an id */
    STRING videoid, hash;
    INTEGER numparts := Length(parts);
    IF(numparts >= 2
       AND IsVimeoVideoId(parts[numparts - 2])
       AND IsVimeoUnlistedHash(parts[numparts - 1])
       AND NOT (numparts >= 3 AND parts[numparts - 3] = "channels")) {
      videoid := parts[numparts - 2];
      hash := parts[numparts - 1];
    } ELSE {
      //otherwise the last numeric part contains the video identifier (eg vimeo.com/channels/staffpicks/<id>)
      FOR(INTEGER i := Length(parts) - 1; i >= 0 ; i := i - 1) {
        IF(IsVimeoVideoId(parts[i])) {
          videoid := parts[i];
          BREAK;
        }
      }
      IF(videoid = "")
        RETURN DEFAULT RECORD; // failed to find the video id

      STRING hashparam := GetVariableFromURL(text, "h");
      IF(IsVimeoUnlistedHash(hashparam))
        hash := hashparam;
    }

    RETURN [ network := "vimeo"
           , videoid := hash != "" ? videoid || "/" || hash : videoid
           , starttime := ParseVimeoStarttime(text)
           ];
  }
  ELSE IF (host_lc = 'youtu.be')
  {
    STRING ARRAY parts := Tokenize(pathname, '/');
    RETURN [ network   := "youtube"
           , videoid   := parts[0]
           , starttime := ParseYoutubeStarttime(text)
           ];
  }
  ELSE IF (host_lc LIKE '*.youtube-nocookie.com' OR host_lc LIKE '*.youtube.com')
  {
    // Check for a video ID as part of the URL path
    IF (   unpacked.urlpath LIKE 'embed/*'
        OR unpacked.urlpath LIKE "v/*"
        OR unpacked.urlpath LIKE "shorts/*")
    {
      STRING ARRAY parts := Tokenize(pathname, '/');
      RETURN [ network   := "youtube"
             , videoid   := parts[1]
             , starttime := ParseYoutubeStarttime(text)
             ];
    }
    ELSE // Check if the video ID is specified in the "v" parameter (/watch?v=)
    {
      STRING videoid := GetVariableFromURL(text, "v");
      RETURN [ network   := "youtube"
             , videoid   := videoid
             , starttime := ParseYoutubeStarttime(text)
             ];
    }
  }

  RETURN DEFAULT RECORD;
}
