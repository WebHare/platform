<?wh
/** Regular expressions
    @topic harescript-core/regex
*/

LOADLIB "wh::util/stringparser.whlib";


/* Internal regex builtins. These follow ECMAScript RegExp semantics, using PCRE2 in the native engine and
   JavaScript's RegExp in the WASM engine. All positions are byte offsets in the (UTF-8) data.
   The flags can only contain 'g', 'i', 'm' and 'u'.
   - EXEC: RegExp.prototype.exec. Starts at lastindex if the 'g' flag is set, otherwise at 0. Returns a default record
     if there is no match, otherwise a record with a 'matches' cell (one record per capture group, with the cells
     'matched', 'start', 'len' and 'value')
   - REPLACE: String.prototype.replace with a regex and a replacement pattern
*/
RECORD FUNCTION __HS_INTERNAL_REGEX_EXEC(STRING data, INTEGER lastindex, STRING pattern, STRING flags) __ATTRIBUTES__(EXTERNAL);
STRING FUNCTION __HS_INTERNAL_REGEX_REPLACE(STRING data, STRING pattern, STRING flags, STRING replacement) __ATTRIBUTES__(EXTERNAL);

/** Returns the length in bytes of the UTF-8 character at a specific position in a string */
INTEGER FUNCTION GetUTF8CharLength(STRING data, INTEGER pos) {
  INTEGER leadbyte := GetByteValue(Substring(data, pos, 1));
  RETURN leadbyte < 0xC0 ? 1 : leadbyte < 0xE0 ? 2 : leadbyte < 0xF0 ? 3 : 4;
}

/** @short Regular expression, closely following ECMAScript (JavaScript)
    @long Regular expressions closely follow the syntax and semantics of JavaScript's RegExp, so most patterns, flags
          and replacement patterns can be used unchanged in JavaScript/TypeScript code. Positions (eg lastindex and the
          start and len of matches) are byte offsets in the UTF-8 encoded input.

          Only the flags 'g', 'i', 'm' and 'u' are supported. Lookbehind assertions, named capture groups and modifiers
          (eg `(?i:...)`) are not supported.

          Patterns always match Unicode code points: characters outside the Basic Multilingual Plane (eg emoji) are a
          single character, also without the 'u' flag (JavaScript without 'u' sees them as two UTF-16 code units). With
          the 'i' flag, letters are always compared as JavaScript does with the 'u' flag (eg 'ſ' matches 's').

          The native HareScript engine uses PCRE2, configured to behave like ECMAScript. Known differences with
          JavaScript in the native engine: U+2028 and U+2029 are not considered line terminators, in multiline mode
          `^` and `$` do not match between the CR and LF of a CRLF sequence, and with the 'i' flag `\w` and `\b` don't
          consider 'ſ' and the Kelvin sign to be word characters.
          Use the 'u' flag for class ranges of characters outside the Basic Multilingual Plane (eg `[😀-🙏]`): without
          it, JavaScript (and so the WASM engine) rejects them, but the native engine doesn't.
          Don't put a quantifier on a lookahead assertion (eg `(?=a)*`): JavaScript doesn't allow this with the 'u'
          flag (so it throws in the WASM engine), but the native engine doesn't reject it.
*/
PUBLIC STATIC OBJECTTYPE RegEx <
  // ---------------------------------------------------------------------------
  //
  // Variables
  //

  /// Regular expression pattern
  STRING pattern;

  // ---------------------------------------------------------------------------
  //
  // Public variables
  //

  /// If set to TRUE, search from lastindex, and set it after the match ('g' flag)
  PUBLIC BOOLEAN global;

  /// If set to TRUE, do a case insensitive match ('i' flag)
  PUBLIC BOOLEAN ignorecase;

  /// If set to TRUE, "^" and "$" also match at the start and end of every line ('m' flag)
  PUBLIC BOOLEAN multiline;

  /// If set to TRUE, enables Unicode mode ('u' flag): characters outside the Basic Multilingual Plane are a single
  /// character, `\u{...}` and `\p{...}` escapes are supported, and the syntax is stricter
  PUBLIC BOOLEAN unicode;

  /// The byte position at which the next search will start for global regular expressions, automatically updated by Exec and Test
  PUBLIC INTEGER lastindex;

  // ---------------------------------------------------------------------------
  //
  // Public properties
  //

  /// The source pattern
  PUBLIC PROPERTY source(pattern, -);

  // ---------------------------------------------------------------------------
  //
  // Constructor
  //

  /** @short Create a regular expression object
      @param pattern The regular expression (not enclosed by slashes)
      @param flags Flags: 'g' (global), 'i' (ignorecase), 'm' (multiline) and/or 'u' (unicode)
  */
  MACRO NEW(STRING pattern, STRING flags DEFAULTSTO "") {
    this->pattern := pattern;

    FOR (INTEGER i := 0, e := LENGTH(flags); i != e; i := i + 1) {
      STRING flagchar := SubString(flags, i, 1);
      IF (SearchSubstring(flags, flagchar, i + 1) >= 0)
        THROW NEW Exception(`Invalid regular expression flags '${flags}': flag '${flagchar}' is specified more than once`);

      SWITCH (flagchar) {
        CASE "g" { this->global := TRUE; }
        CASE "i" { this->ignorecase := TRUE; }
        CASE "m" { this->multiline := TRUE; }
        CASE "u" { this->unicode := TRUE; }
        DEFAULT  { THROW NEW Exception(`Invalid regular expression flags '${flags}': flag '${flagchar}' is not allowed`); }
      }
    }
  }

  // ---------------------------------------------------------------------------
  //
  // Helper functions
  //

  STRING FUNCTION GetFlags() {
    RETURN (this->global ? "g" : "") || (this->ignorecase ? "i" : "") || (this->multiline ? "m" : "") || (this->unicode ? "u" : "");
  }

  /** Execute a match, updating lastindex for global regular expressions (like RegExp.prototype.exec) */
  RECORD FUNCTION DoExec(STRING input) {
    RECORD result := __HS_INTERNAL_REGEX_EXEC(input, this->lastindex, this->pattern, this->GetFlags());
    IF (this->global)
      this->lastindex := RecordExists(result) ? result.matches[0].start + result.matches[0].len : 0;
    RETURN result;
  }

  // ---------------------------------------------------------------------------
  //
  // Public API
  //

  /** @short Search the next match of the regular expression within an input string
      @long Like JavaScript's RegExp.prototype.exec, the search starts at lastindex for global regular expressions
          (and lastindex is updated after the search), and at the start of the input otherwise.
      @param input Input to search a match in
      @return Details about the match. First record describes the entire match (if found), further records describe
         the subexpression matches for every subexpression in the regular expression.
      @cell(boolean) return.matched For the first record TRUE, for the nth (n>=1) record whether subexpression n
          participated in the match.
      @cell(integer) return.start Start of the match (-1 if not matched)
      @cell(integer) return.len Length of the match
      @cell(string) return.value Matched part of the string
  */
  PUBLIC RECORD ARRAY FUNCTION Exec(STRING input) {
    RECORD result := this->DoExec(input);
    RETURN RecordExists(result) ? result.matches : DEFAULT RECORD ARRAY;
  }

  /** @short Replace occurrences of a regular expression
      @long Works like JavaScript's String.prototype.replace with a regular expression: if the global flag is set, every
            occurrence is replaced, otherwise only the first one. The replacement string can contain the patterns `$$`
            (a '$'), `$&` (the matched text), `` $` `` (the text before the match), `$'` (the text after the match)
            and `$n` or `$nn` (the text matched by subexpression n).
      @param input Input to do the replace in
      @param replacewith Replacement string
      @return Input with the occurrences of the regular expression replaced
  */
  PUBLIC STRING FUNCTION Replace(STRING input, STRING replacewith) {
    IF (this->global)
      this->lastindex := 0;
    RETURN __HS_INTERNAL_REGEX_REPLACE(input, this->pattern, this->GetFlags(), replacewith);
  }

  /** @short Replace occurrences of a regular expression by the result of a callback function
      @long This function can be used to find occurrences of a regular expression within a string, and call a function
            for each match. If the function returns a string, the matching occurrence is replaced by the function result.
            If the callback function is a macro, the text is not replaced. The callback function must take four
            arguments: a string which contains the matching text from the input; a string array containing a string for
            each subexpression (empty if the subexpression was not matched); an integer with the position of the matched
            text within the input (before replacement); and a string containing the original input text. If the global
            flag is not set on the regular expression, the callback is only called for the first match.
      @param input Input to do the replace in
      @param replacefunc String function that takes a match and returns a replacement
      @return Input with the occurrences of the regular expression replaced
  */
  PUBLIC STRING FUNCTION ReplaceCallback(STRING input, FUNCTION PTR replacefunc) {
    /* Like JavaScript's String.prototype.replace, first collect all matches and only then call the callback, so the
       callback can safely use this regex object (eg Test, Exec or a nested ReplaceCallback) */
    STRING flags := this->GetFlags();
    RECORD ARRAY allmatches;
    INTEGER searchpos;
    WHILE (TRUE) {
      RECORD match := __HS_INTERNAL_REGEX_EXEC(input, searchpos, this->pattern, flags);
      IF (NOT RecordExists(match))
        BREAK;

      INSERT match INTO allmatches AT END;
      IF (NOT this->global)
        BREAK;

      RECORD fullmatch := match.matches[0];
      searchpos := fullmatch.start + fullmatch.len;
      IF (fullmatch.len = 0) { // Prevent looping on empty matches
        IF (searchpos >= LENGTH(input))
          BREAK;
        searchpos := searchpos + GetUTF8CharLength(input, searchpos);
      }
    }

    // The search for global regexes ends with a failed match, which resets lastindex (before the callbacks run)
    IF (this->global)
      this->lastindex := 0;

    STRING result;
    INTEGER copiedupto;
    FOREVERY (RECORD match FROM allmatches) {
      RECORD fullmatch := match.matches[0];
      result := result || Substring(input, copiedupto, fullmatch.start - copiedupto);
      copiedupto := fullmatch.start + fullmatch.len;

      IF (replacefunc != DEFAULT FUNCTION PTR) {
        STRING ARRAY submatches;
        FOREVERY (RECORD submatch FROM ArraySlice(match.matches, 1))
          INSERT submatch.value INTO submatches AT END;

        VARIANT replacement := CallAnyPtrVA(replacefunc, VARIANT[ fullmatch.value, submatches, fullmatch.start, input ]);
        result := result || (TypeID(replacement) = TypeID(STRING) ? replacement : fullmatch.value);
      }
    }

    RETURN result || Substring(input, copiedupto);
  }

  /** @short Test if a match of the regular expression is present within an input string
      @long Like JavaScript's RegExp.prototype.test, the search starts at lastindex for global regular expressions
          (and lastindex is updated after the search), and at the start of the input otherwise.
      @param input Input to search a match in
      @return Whether a match can be found in the input string
  */
  PUBLIC BOOLEAN FUNCTION Test(STRING input) {
    RETURN RecordExists(this->DoExec(input));
  }
>;

PUBLIC STATIC OBJECTTYPE JSRegEx EXTEND RegEx __ATTRIBUTES__(DEPRECATED "Use RegEx, which now closely follows ECMAScript") < >;

OBJECT parser;

/** @short Create a regular expression pattern to match a LIKE mask
    @long This function can be used to create a regular expression to perform a LIKE match. This function allows for "*" and
          "?" to be escaped as "\*" and "\?", so the literal characters "*" and "?" can be matched (which is not possible
          using LIKE). The resulting pattern can also be used to capture the matched wildcard values.
    @param likemask The LIKE mask to match
    @return The regular expression pattern
    @example
STRING string1 := "Is this a test?";
STRING string2 := "Is this a test!";

// Returns TRUE
BOOLEAN like1 := string1 LIKE "Is * a test?";
// Also returns TRUE (The "?" matches a single character)
BOOLEAN like2 := string2 LIKE "Is * a test?";

// Using "\\?" to escape the "?", so we can match the "?" character itself
STRING pattern := CreateLikeRegexPattern("Is * a test\\?");
OBJECT expression := NEW RegEx(pattern);

// Returns TRUE
BOOLEAN test1 := expression->Test(string1);
// Returns FALSE
BOOLEAN test2 := expression->Test(string2);

// exec1 contains two records, the first containing the complete string, the second containing "this" (matched by the "*")
RECORD ARRAY exec1 := expression->Exec(string1);
// exec2 is a default record array, because it doesn't match
RECORD ARRAY exec2 := expression->Exec(string2);
*/
PUBLIC STRING FUNCTION CreateLikeRegexPattern(STRING likemask)
{
  IF (NOT ObjectExists(parser))
    parser := NEW StringParser();

  parser->Reset(likemask);
  STRING pattern;

  WHILE (NOT parser->eof)
  {
    // Parse non-special characters
    pattern := pattern || parser->ParseWhileNotInSet(".^$*+?()[{\\|");
    IF (parser->eof)
      BREAK;

    // Handle some special cases
    IF (parser->current = "\\" AND SearchSubstring("*?", parser->PeekN(1)) >= 0)
    {
      // If this "\" escapes an "*" or "?", leave it escaped as-is (it will match the literal "*" or "?" character)
      pattern := pattern || parser->ParseN(2); // Parse the "\*" or "\?"
    }
    ELSE IF (parser->current = "*")
    {
      // Convert "*" to "(.*)" (match and capture zero or more characters)
      pattern := pattern || "(.*)";
      parser->SkipN(1); // Skip the "*"
    }
    ELSE IF (parser->current = "?")
    {
      // Convert "?" to "(.)" (match and capture a single character)
      pattern := pattern || "(.)";
      parser->SkipN(1); // Skip the "?"
    }
    ELSE
    {
      // Escape the current special character
      pattern := pattern || "\\" || parser->ParseN(1);
    }
  }

  RETURN pattern;
}
