<?wh
LOADLIB "wh::adhoccache.whlib";
LOADLIB "wh::crypto.whlib";
LOADLIB "wh::files.whlib";
LOADLIB "wh::internal/interface.whlib";
LOADLIB "mod::system/lib/database.whlib";
LOADLIB "mod::system/lib/logging.whlib";
LOADLIB "mod::system/lib/internal/ratelimit.whlib";
LOADLIB "mod::system/lib/internal/registry.whlib";
LOADLIB "mod::system/lib/internal/whcore_interface.whlib";
LOADLIB "mod::system/lib/internal/webserver/support.whlib";

/* Retired secrets are secrets that have been replaced (eg by `wh auth rotate-secrets`) but may still be in use by
   tokens issued before the rotation. A retired secret is only accepted if the caller allows it (acceptretired) and it
   hasn't been disabled yet. Otherwise it's only checked to log that it's still being used. Every use is reported to
   the notice log, which `wh auth list-secrets` reads to show which secrets are still used.

   The TypeScript implementation is in @webhare/services/src/retiredsecrets.ts. Keep the notice fields in sync */

/* The limits below are counted with __CheckRateLimit, which stores them in the adhoc cache. That cache is shared by all
   VMs in a process, so the limits apply to the whole process and not just to the current VM (which may only live for a
   single request) */

/// Log each retired secret + scope combination that is accepted at most once per this interval per process
INTEGER retired_acceptedloginterval := 10 * 60 * 1000;
/// Log at most this many rejected tokens per minute per process
INTEGER retired_maxrejectedperminute := 100;

STRING FUNCTION GetKeyForScope(STRING gcmsecret, STRING scope)
{
  RETURN GetHashForString(DecodeUFS(gcmsecret) || scope, "SHA-256");
}

/* Read the secrets from platform.json, which is also where TypeScript gets them. gen_config.ts copies them from the
   registry and broadcasts system:configupdate when platform.json changes, so rotated secrets reach HareScript and
   TypeScript at the same time */
RECORD FUNCTION GetCacheablePlatformSecrets() {
  RECORD config := DecodeJSONBlob(GetDiskResource(__SYSTEM_WHCOREPARAMETERS().basedataroot || "config/platform.json", [ allowmissing := TRUE ]));
  RETURN [ value := CellExists(config, "secrets") AND TypeID(config.secrets) = TypeID(RECORD) ? config.secrets : DEFAULT RECORD
         , ttl := 60 * 60 * 1000
         , eventmasks := [ "system:configupdate" ]
         ];
}

/** Get one of the cluster secrets
    @param whichkey cachesecret, cookiesecret, debugsecret or gcmsecret
    @return The secret. Throws if the secret is not available */
PUBLIC STRING FUNCTION GetClusterKeyBase(STRING whichkey) {
  IF(whichkey NOT IN [ "cachesecret", "cookiesecret", "debugsecret", "gcmsecret" ])
    THROW NEW Exception(`Unknown cluster key ${whichkey}`);

  RECORD secrets := GetAdhocCached([ type := "platformsecrets" ], PTR GetCacheablePlatformSecrets);
  STRING configname := Left(whichkey, Length(whichkey) - Length("secret")); //platform.json names them cache, cookie, debug, gcm
  STRING secret := CellExists(secrets, configname) AND TypeID(GetCell(secrets, configname)) = TypeID(STRING) ? GetCell(secrets, configname) : "";

  IF(secret = "") {
    /* platform.json doesn't have the secret yet. This happens on a fresh installation, where initdb writes the
       registry keys but platform.json isn't regenerated until post-start. Fall back to the registry */
    RECORD secretkey := GetAdhocCached([ whichkey := whichkey ], PTR RunInSeparatePrimary(PTR __GetRegistryKey("system.webserver.security." || whichkey, TRUE, 60 * 60 * 1000, 0 )));
    IF(CellExists(secretkey, 'value') AND TypeID(secretkey.value) = TypeID(STRING))
      secret := secretkey.value;
  }

  IF(secret = "")
    THROW NEW Exception(`Could not get cluster key ${whichkey}`);
  RETURN secret;
}

RECORD ARRAY FUNCTION GetRetiredSecrets(STRING secrettype) {
  RECORD secrets := GetAdhocCached([ type := "platformsecrets" ], PTR GetCacheablePlatformSecrets);
  IF(NOT CellExists(secrets, "retired") OR TypeID(secrets.retired) != TypeID(RECORD ARRAY))
    RETURN DEFAULT RECORD ARRAY;

  RECORD ARRAY retired;
  FOREVERY(RECORD entry FROM secrets.retired) {
    //gen_config.ts has already validated the entries, but be careful with what we read from disk
    IF(NOT CellExists(entry, "type") OR TypeID(entry.type) != TypeID(STRING) OR entry.type != secrettype
       OR NOT CellExists(entry, "secret") OR TypeID(entry.secret) != TypeID(STRING) OR entry.secret = ""
       OR NOT CellExists(entry, "id") OR TypeID(entry.id) != TypeID(STRING))
      CONTINUE;

    INSERT CELL[ id := entry.id
               , secret := entry.secret
               , compromised := CellExists(entry, "compromised") AND TypeID(entry.compromised) = TypeID(BOOLEAN) AND entry.compromised
               , disabled := CellExists(entry, "disabledsince") AND TypeID(entry.disabledsince) = TypeID(STRING) AND entry.disabledsince != ""
               ] INTO retired AT END;
  }
  RETURN retired;
}

RECORD FUNCTION GetRequestInfoForLog() {
  STRING url, ip;
  IF(RecordExists(shtmlcontext)) {
    url := CellExists(shtmlcontext, "requesturl") ? shtmlcontext.requesturl : "";
    ip := CellExists(shtmlcontext, "remoteip") ? shtmlcontext.remoteip : "";
  } ELSE IF(NOT IsWASM()) {
    TRY {
      url := __WHS_GetRequestURL();
      ip := __WHS_GetClientRemoteIp();
    } CATCH(OBJECT e) {
      //not handling a request
    }
  }

  //Leave out the query string and fragment, tokens are often passed there
  FOREVERY(STRING separator FROM [ "?", "#" ]) {
    INTEGER pos := SearchSubstring(url, separator);
    IF(pos >= 0)
      url := Left(url, pos);
  }

  RECORD info;
  IF(url != "")
    INSERT CELL url := url INTO info;
  IF(ip != "")
    INSERT CELL ip := ip INTO info;
  RETURN info;
}

MACRO ReportRetiredSecretUse(RECORD retired, STRING secrettype, STRING scope, BOOLEAN accepted) {
  RECORD data := CELL[ event := accepted ? "platform:retired-secret-accepted" : "platform:retired-secret-rejected"
                     , secretid := retired.id
                     , secrettype
                     , scope
                     , compromised := retired.compromised
                     , engine := "harescript"
                     ];
  IF(NOT accepted)
    INSERT CELL reason := retired.disabled ? "disabled" : "scope" INTO data;
  data := MakeMergedRecord(data, GetRequestInfoForLog());

  IF(accepted) {
    IF(NOT __CheckRateLimit([ type := "system:retired-secret-accepted", secretid := retired.id, scope := scope ], 1, retired_acceptedloginterval).accepted)
      RETURN;

    LogInfo("system:secrets", `Accepted a ${scope} token using retired ${secrettype} secret ${retired.id}`, data);
    RETURN;
  }

  IF(NOT __CheckRateLimit([ type := "system:retired-secret-rejected" ], retired_maxrejectedperminute, 60 * 1000).accepted) {
    //Say once a minute that we're dropping notices. Unlike the TypeScript version we don't count them, that would need another shared counter
    IF(__CheckRateLimit([ type := "system:retired-secret-suppressed" ], 1, 60 * 1000).accepted)
      LogWarning("system:secrets", `Rejected more than ${retired_maxrejectedperminute} tokens matching retired secrets in the last minute, suppressing further notices`, CELL[ event := "platform:retired-secret-suppressed" ]);
    RETURN;
  }

  STRING message := retired.disabled
      ? `Rejected a ${scope} token matching disabled retired ${secrettype} secret ${retired.id}`
      : `Rejected a ${scope} token matching retired ${secrettype} secret ${retired.id}, this scope does not accept retired secrets`;
  IF(retired.compromised)
    LogError("system:secrets", message, data);
  ELSE
    LogWarning("system:secrets", message, data);
}

/* Try the retired secrets of a type after the current secret failed
   @param secrettype Type of secret to try (cookie, gcm)
   @param scope Scope of the token, for logging
   @param acceptretired Whether the caller accepts tokens created with a retired secret that hasn't been disabled yet
   @param attempt Function receiving a secret, returning a non-empty string (or throwing) if it doesn't match
   @return The result of the attempt with the matching secret, or an empty string if no secret matched or the match wasn't accepted */
STRING FUNCTION TryRetiredSecrets(STRING secrettype, STRING scope, BOOLEAN acceptretired, FUNCTION PTR attempt) {
  FOREVERY(RECORD retired FROM GetRetiredSecrets(secrettype)) {
    STRING result;
    TRY {
      result := attempt(retired.secret);
    } CATCH(OBJECT e) {
      //not this secret
    }
    IF(result = "")
      CONTINUE;

    BOOLEAN accepted := acceptretired AND NOT retired.disabled;
    ReportRetiredSecretUse(retired, secrettype, scope, accepted);
    RETURN accepted ? result : "";
  }
  RETURN "";
}

STRING FUNCTION DecryptGCM(STRING gcmsecret, STRING scope, STRING ARRAY toks) {
  STRING keyforscope := GetKeyForScope(gcmsecret, scope);
  RETURN __DoEvpCrypt("aes-256-gcm", FALSE, keyforscope, DecodeUFS(toks[0]), DecodeUFS(toks[1]), DecodeUFS(toks[2])).data;
}

STRING FUNCTION DecryptLegacy(STRING cookiesecret, STRING data, STRING algorithm, STRING scope) {
  RETURN DecryptSignedData(data, algorithm, cookiesecret || scope);
}

STRING FUNCTION CalculateSignature(STRING cookiesecret, STRING scope, STRING text) {
  RETURN EncodeUFS(GetHashForString(text || "\t" || scope || "\t" || cookiesecret, "SHA-256"));
}

STRING FUNCTION MatchSignature(STRING cookiesecret, STRING scope, STRING text, STRING signature) {
  RETURN CalculateSignature(cookiesecret, scope, text) = signature ? "match" : "";
}

/** @short Encrypt data with this server's local key
    @param scope Scope for encryption (must be unique for each Encrypt usage so you can't accidentally mix up calls)
    @param data Data to sign and encrypt. Will be encoded as necessary
    @cell options.algorithm Algorithm to use, defaults to 'SHA-1,BLOWFISH+CBC,8'
    @return UFS encoded encrypted and signed data
    @topic modules/services
    @public
    @loadlib mod::system/lib/services.whlib
*/
PUBLIC STRING FUNCTION EncryptForThisServer(STRING scope, VARIANT data, RECORD options DEFAULTSTO DEFAULT RECORD)
{
  options := ValidateOptions([algorithm := ""], options);
  IF(options.algorithm = "" OR TypeID(data)!=TypeID(STRING) OR data="" OR Left(data,5) = "hson:")
    data := EncodeHSON(data);

  IF(options.algorithm = "")
  {
    STRING keyforscope := GetKeyForScope(GetClusterKeyBase("gcmsecret"), scope);
    STRING iv := GenerateRandomBinaryValue(12);
    RECORD parts := __DoEvpCrypt("aes-256-gcm", TRUE, keyforscope, data, iv, "");
    RETURN `${EncodeUFS(parts.data)}.${EncodeUFS(iv)}.${EncodeUFS(parts.tag)}`;
  }
  ELSE
  {
    RETURN EncryptAndSignData(data, options.algorithm, GetClusterKeyBase("cookiesecret") || scope);
  }
}

/** @short Decrypt data with this server's local key
    @param scope Scope for encryption (must match scope used when encrypting)
    @param data Data to encrypt
    @cell options.algorithm Algorithm to use, defaults to 'SHA-1,BLOWFISH+CBC,8'
    @cell options.fallback Fallback value if decryption failed. If not specified, the function will throw on decryption failure
    @cell options.acceptretired Also accept data encrypted with a retired secret that hasn't been disabled yet. Only use this for
          data that may need to remain valid for a long time and is not security sensitive, eg. form targets in published pages
    @return Decrypted data
    @topic modules/services
    @public
    @loadlib mod::system/lib/services.whlib
*/
PUBLIC VARIANT FUNCTION DecryptForThisServer(STRING scope, STRING data, RECORD options DEFAULTSTO DEFAULT RECORD)
{
  options := ValidateOptions( [ algorithm := ""
                              , fallback := DEFAULT RECORD
                              , acceptretired := FALSE
                              ], options, [ optional := ["fallback"], notypecheck := ["fallback" ] ]);

  STRING decrypted;
  BOOLEAN isgcm := options.algorithm = "" AND data LIKE "*.*.*" AND data NOT LIKE "*.*.*.*";
  IF(isgcm)
  {
    STRING ARRAY toks := Tokenize(data,'.');
    //Try JS AES-GCM compatible algorithm first
    STRING gcmsecret := GetClusterKeyBase("gcmsecret");
    TRY
    {
      decrypted := DecryptGCM(gcmsecret, scope, toks);
    }
    CATCH(OBJECT error)
    {
      //decryption failed, just ignore
    }
    IF(decrypted = "")
      decrypted := TryRetiredSecrets("gcm", scope, options.acceptretired, PTR DecryptGCM(#1, scope, toks));
  }
  ELSE
  {
    STRING algorithm := options.algorithm ?? "SHA-1,BLOWFISH+CBC,8";
    decrypted := DecryptLegacy(GetClusterKeyBase("cookiesecret"), data, algorithm, scope);
    IF(decrypted = "")
      decrypted := TryRetiredSecrets("cookie", scope, options.acceptretired, PTR DecryptLegacy(#1, data, algorithm, scope));
  }

  IF(decrypted="")
  {
    IF(CellExists(options,'fallback'))
      RETURN options.fallback;
    THROW NEW Exception("Value decryption failed");
  }

  VARIANT retval;
  IF(Left(decrypted,5) = "hson:")
    retval := DecodeHSON(decrypted);
  ELSE IF(isgcm)
    RETURN DecodeJSON(decrypted, DEFAULT RECORD, [ typed := TRUE ]);
  ELSE
    retval := decrypted;

  IF(CellExists(options, 'fallback') AND TYPEID(options.fallback) != TYPEID(retval))
    THROW NEW Exception(`Invalid type in decrypted value, got ${GetTypeName(TYPEID(retval))} but expected ${GetTypeName(TYPEID(options.fallback))}`);
  RETURN retval;
}

//Create a signature for this server
PUBLIC STRING FUNCTION GetSignatureForThisServer(STRING scope, STRING text)
{
  RETURN CalculateSignature(GetClusterKeyBase("cookiesecret"), scope, text);
}
//Validate a generated signature. Signatures made with a retired secret are never accepted, but are logged
PUBLIC BOOLEAN FUNCTION ValidateSignatureForThisServer(STRING scope, STRING text, STRING signature)
{
  IF(GetSignatureForThisServer(scope, text) = signature)
    RETURN TRUE;

  TryRetiredSecrets("cookie", scope, FALSE, PTR MatchSignature(#1, scope, text, signature));
  RETURN FALSE;
}
