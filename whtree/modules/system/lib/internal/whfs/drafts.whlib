<?wh
LOADLIB "wh::datetime.whlib";

LOADLIB "mod::system/lib/database.whlib";
LOADLIB "mod::system/lib/internal/typecoder.whlib";
LOADLIB "mod::system/lib/internal/dbschema.whlib";
LOADLIB "mod::system/lib/internal/whfs/base.whlib";
LOADLIB "mod::system/lib/internal/whfs/support.whlib" ;
LOADLIB "mod::system/lib/internal/whfs/contenttypes.whlib" ;
LOADLIB "mod::system/lib/internal/whfs/events.whlib";
LOADLIB "mod::system/lib/internal/whfs/history.whlib" ;
LOADLIB "mod::system/lib/internal/webhareconstants.whlib" ;

PUBLIC CONSTANT STRING ARRAY workflow_controlled_fields := ["DATA", "TITLE", "DESCRIPTION", "KEYWORDS" ];

RECORD FUNCTION StringVersionToParts(STRING stringversion)
{
  STRING ARRAY toks := Tokenize(stringversion || '.0', '.'); //append .0 so we can always find a patch
  IF(Length(toks) < 3)
    RETURN DEFAULT RECORD;

  RETURN CELL[ major := ToInteger(toks[0], 0)
             , minor := ToInteger(toks[1], 0)
             , patch := ToInteger(toks[2], 0)
             ];
}

PUBLIC RECORD FUNCTION GetLastSnapshotVersion(INTEGER source)
{
  RECORD ARRAY currentversions := SELECT version, userdata
                                    FROM system_internal.fs_history
                                   WHERE fs_object = VAR source
                                         AND version != "";
  currentversions := SELECT *, parts := StringVersionToParts(version) FROM currentversions;
  RETURN (SELECT AS RECORD CELL[ parts.major
                               , parts.minor
                               , parts.patch
                               , userdata := DecodeHSONOrJSONRecord(userdata)
                               ] FROM currentversions
                                WHERE RecordExists(parts)
                                ORDER parts.major DESC, parts.minor DESC, parts.patch DESC
                                LIMIT 1)
         ?? [ userdata := DEFAULT RECORD, major := 0, minor := 0, patch := 0 ];
}

PUBLIC INTEGER FUNCTION CreateFullSnapshot(DATETIME now, INTEGER baseobjectid, INTEGER modifiedby) {
  INTEGER destid := MakeAutonumber(system.fs_objects, "id");
  RECORD objinfo := SELECT name, parent, parentsite, isfolder, type, data, title, description, keywords FROM system.fs_objects WHERE id = VAR baseobjectid;
  RECORD fields := CELL
              [ id := destid
              , parent := EnsureSnapshotsFolder(objinfo.parentsite)
              , name := ToString(destid)
              , creationdate := now
              , modificationdate := now
              , ...PickCells(objinfo, STRING[...workflow_controlled_fields, "type"])
              , snapshotfor := baseobjectid
              , modifiedby
              ];
  INSERT fields INTO system.fs_objects;

  //We're building a full snapshot. So instancesource (the snapshot) should receive all copyable instances from destid (the final)
  RECORD ARRAY snapshot_current_instances := ListInstances(baseobjectid);
  FOREVERY(RECORD inst FROM snapshot_current_instances)
    IF(inst.cloneonarchive) {
      OBJECT typeobj := OpenWHFSType(inst.namespace, [ openorphans := TRUE ]);
      typeobj->SetInstanceData(destid, typeobj->GetInstanceData(baseobjectid), [ ifreadonly := "update", isvisibleedit := FALSE, workflow := FALSE ]);
    }

  OBJECT typeobj := OpenWHFSType("http://www.webhare.net/xmlns/publisher/draftmetadata");
  typeobj->SetInstancedata(destid,
      [ name :=       objinfo.name
      ], [ ifreadonly := "update" ]);

  GetWHFSCommitHandler()->ObjectCreate(0, fields.parent, destid, CellExists(fields, "ISFOLDER") AND fields.isfolder);

  RETURN destid;
}

/** Get the change history for this object
    @return Change history items
    @cell(string) return.id History item id
    @cell(string) return.type One of 'recycled', 'saved', 'reverted', 'created', 'approved'
    @cell(integer) return.user User authobject id
    @cell(integer) return.snapshot WHFS id of the file with the contents for this history
    @cell(datetime) return.when Modification time
    @cell(datetime) return.isactive Whether this is the current active version
    @cell(string) return.version Version number. First version is 0.1, first published version is 1.0
*/
PUBLIC RECORD ARRAY FUNCTION ListObjectHistory(INTEGER objid, RECORD options DEFAULTSTO DEFAULT RECORD) {
  RECORD ARRAY items := QueryObjectHistory([ files := [ objid ] , ...options ]);

  INTEGER lastactive := -1;
  FOREVERY (RECORD rec FROM items)
    IF (rec.type IN [ "final", "approved", "created" ])
      lastactive := #rec;
  IF (lastactive >= 0)
    items[lastactive].isactive := TRUE;

  RETURN items;
}

/** Queries object history. Returns an array of history items for the specified files, sorted on file (fs_object), when, and then history id
    @param options Options for querying object history
    @cell options.files Array of object ids to query history for
    @cell options.date_start Start date for history items
    @cell options.date_limit End date for history items
    @cell options.include_autosaves Whether to include autosave history items
    @return Array of history items for the specified files
    @cell return.id History item id
    @cell return.type One of 'recycled', 'saved', 'reverted', 'created', 'approved'
    @cell return.user User authobject id
    @cell return.snapshot WHFS id of the file with the contents for this history
    @cell return.when Modification time
    @cell return.version Version number. First version is 0.1, first published version is 1.0
*/
PUBLIC RECORD ARRAY FUNCTION QueryObjectHistory(RECORD options DEFAULTSTO DEFAULT RECORD) {
  options := ValidateOptions(CELL[
    files := INTEGER[],
    date_start := DEFAULT DATETIME,
    date_limit := MAX_DATETIME,
    include_autosaves := FALSE
  ], options, [
    optional := [ "files" ]
  ]);

  RETURN
     SELECT id
          , fs_object
          , type := type >= 0 AND type < Length(whconstant_historytypes) ? whconstant_historytypes[type] : "#" || type
          , user
          , userdata := DecodeHSONOrJSONRecord(userdata)
          , when
          , snapshot
          , version
          , isactive :=     snapshot = fs_object
          , name := currentname
       FROM system_internal.fs_history
      WHERE (CellExists(options, "FILES") ? fs_object IN options.files : TRUE)
        AND when >= options.date_start
        AND when < options.date_limit
        AND (options.include_autosaves ? TRUE : type NOT IN [whconstant_historytype_autosave, whconstant_historytype_abandoned_autosave ])
   ORDER BY fs_object, when, id;
}

PUBLIC RECORD FUNCTION GetCurrentVersion(INTEGER objid) {
  RECORD fileinfo := SELECT whfspath, snapshotfor FROM system.fs_objects WHERE id = objid;
  IF(NOT RecordExists(fileinfo))
    THROW NEW Exception(`Object #${objid} does not exist`);

  IF(IsRecycleOrHistoryWHFSPath(fileinfo.whfspath)) {
    RECORD ARRAY history := ListObjectHistory(fileinfo.snapshotfor, [ include_autosaves := TRUE ]);
    RECORD ARRAY matches := SELECT * FROM history WHERE snapshot = objid;
    IF(Length(matches) != 1) {
      dumpvalue(history);
      abort(`Object #${objid} is a snapshot but no unique history entry was found for it`);
    }
    RETURN [ version := matches[0].version, liveversion := fileinfo.snapshotfor ];
  }

  RECORD ARRAY history := ListObjectHistory(objid);
  RETURN SELECT version, liveversion := VAR objid FROM history WHERE isactive;
}

PUBLIC MACRO CopyWorkflowInstances(INTEGER instancesource, INTEGER destid, INTEGER ARRAY addworkflowtypes, BOOLEAN isfinal) {
  RECORD ARRAY instances := ListInstances(instancesource);
  INTEGER ARRAY copiedtypes;

  FOREVERY(RECORD inst FROM instances) {
    IF(inst.workflow OR inst.fstype IN addworkflowtypes) {
      INSERT destid INTO copiedtypes AT END;
      OBJECT typeobj := OpenWHFSType(inst.namespace);
      typeobj->SetInstanceData(destid, typeobj->GetInstanceData(instancesource),
          [ ifreadonly := "update", isvisibleedit := FALSE, workflow := NOT isfinal ]);
    }
  }

  //Create explicit empty instances as needed
  IF(NOT isfinal)
    FOREVERY(INTEGER typ FROM addworkflowtypes) {
      IF(typ NOT IN copiedtypes) {
        RECORD typeinfo := SELECT namespace FROM system.fs_types WHERE id = typ;
        IF(RecordExists(typeinfo)) {
          OBJECT typeobj := OpenWHFSType(typeinfo.namespace);
          typeobj->SetInstanceData(destid, CELL[], [ ifreadonly := "update", isvisibleedit := FALSE, workflow := TRUE ]);
        }
      }
    }
}

PUBLIC OBJECT FUNCTION OpenWHFSDraft(INTEGER draftid) __ATTRIBUTES__(DEPRECATED "Unavailable since WebHare 6.0") {
  RETURN DEFAULT OBJECT; //there are still external users, don't fully break them yet
}

/** Start a workflow update (create an autosave to have an object that can receive a RTD being updated)
    @param objid - The ID of the object we're updating. Draft or final object id */
PUBLIC INTEGER FUNCTION StartWorkflowUpdate(OBJECT baseobject, INTEGER objid, RECORD metadata, OBJECT user, INTEGER ARRAY workflowtypes, STRING setversion) {

  // Set up the new object (the 'autosave', or at least it will be an autosave as soon as we start writing data from editdocument here)
  DATETIME now := GetCurrentDateTime();
  INTEGER destid := MakeAutonumber(system.fs_objects, "id");
  INTEGER setparent := EnsureSnapshotsFolder(baseobject->parentsite);
  INSERT CELL [ id := destid
              , parent := setparent
              , name := ToString(destid)
              , creationdate := now
              , modificationdate := now
              , ...PickCells(metadata, workflow_controlled_fields)
              , type := baseobject->type
              , snapshotfor := baseobject->id
              , modifiedby := ObjectExists(user) ? user->authobjectid : 0
              ] INTO system.fs_objects;

  CopyWorkflowInstances(objid, destid, workflowtypes, FALSE);

  INSERT CELL [ fs_object := baseobject->id
              , user := ObjectExists(user) ? user->authobjectid : 0
              , userdata := EncodeHSON(ObjectExists(user) ? user->GetUserDataForLogging() : DEFAULT RECORD)
              , type := whconstant_historytype_autosave
              , when := now
              , snapshot := destid
              , currentname := metadata.name
              , version := setversion
              ] INTO system_internal.fs_history;

  IF(metadata.name != "" ) {
    OBJECT typeobj := OpenWHFSType("http://www.webhare.net/xmlns/publisher/draftmetadata");
    typeobj->SetInstancedata(destid, CELL[ metadata.name ], [ ifreadonly := "update", isvisibleedit := FALSE ]);
  }

  // Fire events
  OBJECT commithandler := GetWHFSCommitHandler();
  commithandler->ObjectHistoryChange(baseobject->parentsite, baseobject->parent, baseobject->id, baseobject->isfolder);
  commithandler->ObjectCreate(0, setparent, destid, FALSE);

  RETURN destid;
}

PUBLIC MACRO ImportCurrentState(INTEGER baseobjectid) {
  DATETIME now := GetCurrentDateTime();
  INTEGER destid := CreateFullSnapshot(now, baseobjectid, 0);

  //Add history record
  INSERT CELL [ fs_object := baseobjectid
              , type := whconstant_historytype_import
              , when := now
              , version := "1.0"
              , snapshot := destid
              ] INTO system_internal.fs_history;
}
