<?wh

LOADLIB "wh::files.whlib";
LOADLIB "wh::xml/dom.whlib";
LOADLIB "wh::os.whlib";

LOADLIB "mod::system/lib/configure.whlib";
LOADLIB "mod::system/lib/testframework.whlib";
LOADLIB "mod::system/lib/internal/whconfig.whlib";

MACRO TestSemvers()
{
  TestEq(TRUE, IsWebhareVersionMatch(">= 4.25.0"));
  TestEq(FALSE, IsWebhareVersionMatch("< 4.25.0"));
  TestEq(TRUE, IsModuleVersionMatch("consilio", ">= 4.25.0"));
  TestEq(FALSE, IsModuleVersionMatch("consilio", "< 4.25.0"));
}

MACRO TestApplicability()
{
  STRING platform := GetEnvironmentVariable("WEBHARE_PLATFORM");
  TestAssert(platform != "", `Cannot run this test if WEBHARE_PLATFORM is unset`);
  STRING stagerole := "platform:" || GetDTAPStage(); //always active

  OBJECT xmldoc := MakeXMLDocument(StringToBlob(
    `<xml>
      <node xml:id="test1" ifmodules="system; publisher" />
      <node xml:id="test2" ifmodules="system; neversuchmodule" />
      <node xml:id="test3" ifmodules="system;;;" />
      <node xml:id="test4" ifmodules="System" />
      <node xml:id="test5" ifenvironset="WEBHARE_PLATFORM" />
      <node xml:id="test6" unlessenvironset="WEBHARE_PLATFORM" />
      <node xml:id="test7" ifenvironset="WEBHARE_PLATFORM=dummy" />
      <node xml:id="test8" ifenvironset="WEBHARE_PLATFORM=${platform} WEBHARE_PLATFORM" />
      <node xml:id="test9" unlessenvironset="WEBHARE_PLATFORM=dummy OTHERENV" />
      <node xml:id="test10" unlessenvironset="WEBHARE_PLATFORM=${platform}" />
      <node xml:id="test11" unlessenvironset="WEBHARE_PLATFORM=dummy WEBHARE_PLATFORM" />
      <node xml:id="test12" ifmodules="webhare_testsuite" />
      <node xml:id="test13" ifmodules="webhare_testsuite >= 1.0" />
      <node xml:id="test14" ifmodules="webhare_testsuite>=1.0 &lt;9.99" />
      <node xml:id="test15" ifmodules="webhare_testsuite>=1.0;webhare_testsuite&lt;9.99" />
      <node xml:id="test16" ifmodules="webhare_testsuite>=1.0;webhare_testsuite>9.99" />
      <node xml:id="test17" ifserverroles="${stagerole}" />
      <node xml:id="test18" ifserverroles="webhare_testsuite:neverset ${stagerole}" />
      <node xml:id="test19" ifserverroles="webhare_testsuite:neverset" />
      <node xml:id="test20" unlessserverroles="${stagerole}" />
      <node xml:id="test21" unlessserverroles="webhare_testsuite:neverset" />
      <node xml:id="test22" unlessserverroles="webhare_testsuite:neverset ${stagerole}" />

    </xml>`));

  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test1")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test2")));
  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test3")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test4")));

  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test5")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test6")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test7")));
  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test8")));
  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test9")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test10")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test11")));

  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test12")));
  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test13")));
  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test14")));
  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test15")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test16")));

  // Server roles: ifserverroles needs any of the roles, unlessserverroles fails if any of them is active
  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test17")));
  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test18")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test19")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test20")));
  TestEq(TRUE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test21")));
  TestEq(FALSE, IsNodeApplicableToThisWebHare(xmldoc->GetElementById("test22")));

  // Peers running an older WebHare don't send their server roles, and older stored restrictions lack the new cells
  RECORD oldpeer := GetMyApplicabilityInfo();
  DELETE CELL serverroles FROM oldpeer;
  TestEq(TRUE, GetApplicabilityError(oldpeer, ReadApplicableToWebHareNode(xmldoc->GetElementById("test17"))) != "");
  TestEq(TRUE, GetApplicabilityError(oldpeer, ReadApplicableToWebHareNode(xmldoc->GetElementById("test21"))) = "");
  RECORD oldrestrictions := ReadApplicableToWebHareNode(xmldoc->GetElementById("test12"));
  DELETE CELL ifserverroles, unlessserverroles FROM oldrestrictions;
  TestEq("", GetApplicabilityError(GetMyApplicabilityInfo(), oldrestrictions));
}

MACRO TestServerRoles()
{
  STRING stagerole := "platform:" || GetDTAPStage(); //always active
  TestEq(TRUE, stagerole IN GetServerRoles());
  TestEq(TRUE, HasServerRole(stagerole));
  TestEq(FALSE, HasServerRole("webhare_testsuite:neverset"));
  TestThrowsLike("*Invalid server role name 'primary'*", PTR HasServerRole("primary"));
}

MACRO TestConfigurationAndVersion()
{
  TestEq(TRUE, GetWebhareVersionInfo().versionnum >= 43600 AND GetWebhareVersionInfo().versionnum < 99999);
  IF(GetWebhareVersionInfo().docker)
  {
    TestEq(40,Length(GetWebhareVersionInfo().committag));
    TestEq(FALSE, GetWebhareVersionInfo().builddatetime LIKE '*"*');
  }
}

MACRO TestWithModule()
{
  testfw->SetupTestModule();
  TestEq(TRUE, IsModuleVersionMatch("webhare_testsuite_temp", ">= 0.1.0"));
  TestEq(FALSE, IsModuleVersionMatch("webhare_testsuite_temp", "< 0.1.0"));
  TestEq(FALSE, IsModuleVersionMatch("__nosuchmodule__", ">= 0.1.0"));
}

RunTestframework([ PTR TestSemvers
                 , PTR TestApplicability
                 , PTR TestServerRoles
                 , PTR TestConfigurationAndVersion
                 , PTR TestWithModule
                 ]);
