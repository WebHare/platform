MACRO TranslateLibraryPath()
{
  STRING whpath := GetWebHareResourceDiskPath("mod::system/whlibs/");
  STRING whrespath := GetWebHareResourceDiskPath("mod::system/whres/");

  TestEq("wh::internal/formatter.whlib", __HS_INTERNAL_TRANSLATELIBRARYPATH(whpath || "/internal/formatter.whlib"));
}

MACRO RelativeEscapeTest()
{
  OpenTest("TestLoadlib: RelativeEscapeTest");

  // mod:: - relative:: may move around inside the module but never above its root
  STRING modloader := "mod::webhare_testsuite/tests/baselibs/hsengine/test.whscr";
  TestEq("mod::webhare_testsuite/tests/baselibs/hsengine/a.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "relative::a.whlib"));
  TestEq("mod::webhare_testsuite/tests/a.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "relative::../../a.whlib"));
  TestEq("mod::webhare_testsuite/a.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "relative::../../../a.whlib"));
  TestEq("mod::webhare_testsuite/a.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "relative::/a.whlib"));
  TestEq("mod::webhare_testsuite/a.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "relative::/x/../a.whlib"));
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "relative::../../../../system/lib/resources.whlib"));
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "relative::x/../../../../../system/lib/resources.whlib"));
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "relative::/../system/lib/resources.whlib"));
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "relative::/x/../../system/lib/resources.whlib"));
  // and absolute mod:: paths may not use .. to reach another module either
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "mod::webhare_testsuite/../system/lib/resources.whlib"));
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(modloader, "mod::webhare_testsuite/x/../../system/lib/resources.whlib"));

  // collapsing keeps the trailing slash of folders
  TestEq("mod::webhare_testsuite/tests/", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY("", "mod::webhare_testsuite/tests/"));
  TestEq("mod::webhare_testsuite/tests/", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY("", "mod::webhare_testsuite/tests/x/../"));
  TestEq("wh::files.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY("", "mod::system/whlibs/files.whlib"));

  // collapsing doesn't leave double slashes after the module name
  TestEq("mod::webhare_testsuite/lib/system/resources.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY("", "module::webhare_testsuite//system//resources.whlib"));
  TestEq("mod::webhare_testsuite/lib/system/resources.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY("", "mod::webhare_testsuite//lib//system/resources.whlib"));
  TestEq("mod::webhare_testsuite/", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY("", "mod::webhare_testsuite//"));
  TestEq("wh::files.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY("", "wh:://files.whlib"));
  // libraries can still be opened by their mod::system/whlibs/ path (which resolves to wh::)
  TestEq(TRUE, MakeFunctionPtr("mod::system/whlibs/files.whlib#GetDiskResource") != DEFAULT FUNCTION PTR);

  CloseTest("TestLoadlib: RelativeEscapeTest");
}

MACRO NoStorageLoadlibTest()
{
  OpenTest("TestLoadlib: NoStorageLoadlibTest");

  // storage:: paths still resolve (they're used for resources), and relative:: may not escape the module's storage
  STRING storageloader := "storage::webhare_testsuite/a/b/test.whlib";
  TestEq("storage::webhare_testsuite/a/b/c.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(storageloader, "relative::c.whlib"));
  TestEq("storage::webhare_testsuite/c.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(storageloader, "relative::../../c.whlib"));
  TestEq("storage::webhare_testsuite/c.whlib", __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(storageloader, "relative::/c.whlib"));
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(storageloader, "relative::../../../system/c.whlib"));
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(storageloader, "relative::x/../../../../system/c.whlib"));
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(storageloader, "relative::/../system/c.whlib"));
  TestThrowsLike("*may not escape*", PTR __HS_INTERNAL_RESOLVEABSOLUTELIBRARY(storageloader, "storage::webhare_testsuite/../system/c.whlib"));

  // but libraries can't be loaded from storage::, even if the file exists

  STRING libpath := GetWebHareResourceDiskPath("storage::webhare_testsuite/test_loadlib.whlib");
  CreateDiskDirectoryRecursive(GetWebHareResourceDiskPath("storage::webhare_testsuite/"), TRUE);
  StoreDiskFile(libpath, StringToBlob(`<?wh PUBLIC STRING FUNCTION LoadlibTarget() { RETURN "ok"; }`), [ overwrite := TRUE ]);
  errors := TestCompile(`<?wh LOADLIB "storage::webhare_testsuite/test_loadlib.whlib";`);
  DeleteDiskFile(libpath);
  MustContainError(1, errors, 165, "storage", "storage::webhare_testsuite/test_loadlib.whlib");
  // not even when the prefix is spelled differently
  TestThrowsLike("*storage*", PTR MakeFunctionPtr("Storage::webhare_testsuite/test_loadlib.whlib#LoadlibTarget"));

  CloseTest("TestLoadlib: NoStorageLoadlibTest");
}

MACRO ObjectStructures()
{
  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; STATIC OBJECTTYPE test EXTEND objecttype3ext < MACRO NEW() { this->memberx3 := 0; } >; ?>');
  TestCleanResult(0, errors);
}

MACRO ConstantTest()
{
  TestAnnotatedCompile(`<?wh LOADLIB "wh::float.whlib"; LOADLIB "wh::datetime.whlib";
pi := 3f;
// <- E:261
MAX_DATETIME := MakeDate(2000, 1, 1);
// <- E:261`);

  result := TestCompileAndRun('<?wh PUBLIC MACRO Test(FLOAT x DEFAULTSTO pi) { PRINT(FormatFloat(x, 2)); } Test();');
  TestCleanResult(5,result.errors);
  TestEq("3.14", result.output);

  TestAnnotatedCompile(`<?wh LOADLIB "wh::float.whlib";
CONSTANT FLOAT my_pi := pi;
`);
}

DeinitTest();
SyntaxTest();
ExportTest();
AmbiguityTest();
CirularReferenceTest();
NoDirectLoadlibtest();
DeinitTest();
TranslateLibraryPath();
RelativeEscapeTest();
NoStorageLoadlibTest();
ObjectStructures();
ConstantTest();
