<?wh
/// @short Internet functions test


LOADLIB "wh::files.whlib";
LOADLIB "wh::internal/hsselftests.whlib";
LOADLIB "wh::internal/interface.whlib";
LOADLIB "mod::system/lib/resources.whlib";


RECORD result;
RECORD ARRAY errors;

MACRO SyntaxTest()
{
  OpenTest("TestLoadlib: SyntaxTest");

  // non-prefixed paths
  errors := TestCompile('<?wh LOADLIB "wrong"; ?>');
  MustContainError(2, errors, 184, 'wrong');

  // error loadlib with a lot of metadata, should not crash
  errors := TestCompile('<?wh LOADLIB "wrong" __ATTRIBUTES__(USED) EXPORT a, b; ?>');
  MustContainError(2, errors, 184, 'wrong');

  // unknown prefix paths
  errors := TestCompile('<?wh LOADLIB "wrong::data.whlib"; ?>');
  MustContainError(2, errors, 165, "wrong", "wrong::data.whlib");

  // 'storage' prefix paths
  errors := TestCompile('<?wh LOADLIB "storage::module/data.whlib"; ?>');
  MustContainError(2, errors, 165, "storage", "storage::module/data.whlib");

  //No relative paths
  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/../testdata_loadlib_a.whlib"; ?>');
  MustContainError(2, errors, 184, "mod::webhare_testsuite/tests/baselibs/hsengine/../testdata_loadlib_a.whlib");

  //No backslashes relative paths
  errors := TestCompile('<?wh LOADLIB "wh::internet\\\\ftp.whlib"; ?>');
  MustContainError(3, errors, 184, "wh::internet\\ftp.whlib");

  //No terminating spaces or dots
  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_a.whlib "; ?>');
  MustContainError(4, errors, 184, "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_a.whlib ");
  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_a.whlib."; ?>');
  MustContainError(5, errors, 184, "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_a.whlib.");

  //No spaces and dots inside paths
  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/a /testdata_loadlib_a.whlib"; ?>');
  MustContainError(6, errors, 184, "mod::webhare_testsuite/tests/baselibs/hsengine/a /testdata_loadlib_a.whlib");
  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/b./testdata_loadlib_a.whlib"; ?>');
  MustContainError(7, errors, 184, "mod::webhare_testsuite/tests/baselibs/hsengine/b./testdata_loadlib_a.whlib");

  //Once got harescript crashing with missing lib and no export
  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/\x80.whlib" EXPORT i; ?>');
  IF (IsWasm())
    MustContainError(8, errors, 184, "mod::webhare_testsuite/tests/baselibs/hsengine/.whlib");
  ELSE
    MustContainError(8, errors, 184, "mod::webhare_testsuite/tests/baselibs/hsengine/\x80.whlib");

  CloseTest("TestLoadlib: SyntaxTest");
}

MACRO ExportTest()
{
  OpenTest("TestLoadlib: ExportTest");

  result := TestCompileAndRun('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; deep_func1(); ?>');
  TestCleanResult(1, result.errors);

  result := TestCompileAndRun('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; deep_var1 := ""; ?>');
  TestCleanResult(2, result.errors);

  result := TestCompileAndRun('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; OBJECT x := NEW deep_objecttype1; PRINT(""||x->memberx); ?>');
  TestCleanResult(3, result.errors);
  TestEq("0", result.output);

  result := TestCompileAndRun('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; OBJECT x := NEW deep_objecttype2; PRINT(""||x->memberx); ?>');
  TestCleanResult(5, result.errors);
  TestEq("7", result.output);

  CloseTest("TestLoadlib: ExportTest");
}

MACRO AmbiguityTest()
{
  OpenTest("TestLoadlib: AmbiguityTest");

  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_a.whlib"; LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; func1(); ?>');
  MustContainError(1, errors, 114, "FUNC1");

  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_a.whlib"; LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; int1; ?>');
  MustContainError(2, errors, 114, "INT1");

  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_a.whlib"; LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; mac1(); ?>');
  MustContainError(3, errors, 114, "MAC1");

  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_a.whlib"; LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; deep_func1(); ?>');
  TestCleanResult(4, errors);

  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_c.whlib" EXPORT deep_func1; LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib";  ?>');
  TestCleanResult(5, errors);

  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_b.whlib"; LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_c.whlib" EXPORT deep_func1;  ?>');
  TestCleanResult(6, errors);

  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_c.whlib"; LOADLIB "wh::datetime.whlib" EXPORT deep_func1;  ?>');
  MustContainError(7, errors, 9, "DEEP_FUNC1");

  CloseTest("TestLoadlib: AmbiguityTest");
}

MACRO CirularReferenceTest()
{
  OpenTest("TestLoadlib: CircularReferenceTest");

  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_circ_a.whlib";  ?>');
  MustContainError(1, errors, 179, "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_circ_a.whlib");

  errors := TestCompile('<?wh LOADLIB "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_circ_b.whlib";  ?>');
  MustContainError(2, errors, 179, "mod::webhare_testsuite/tests/baselibs/hsengine/testdata_loadlib_circ_b.whlib");

  CloseTest("TestLoadlib: CircularReferenceTest");
}

MACRO DeinitTest()
{
  OpenTest("TestLoadlib: DeinitTest");

  errors := TestCompile('<?wh PUBLIC INTEGER FUNCTION Test1() __ATTRIBUTES__(DEINITMACRO) { RETURN 0; }');
  MustContainError(1, errors, 20);
  errors := TestCompile('<?wh PUBLIC MACRO Test1(INTEGER a) __ATTRIBUTES__(DEINITMACRO) { }');
  MustContainError(2, errors, 20);
  errors := TestCompile('<?wh PUBLIC MACRO Test1() __ATTRIBUTES__(DEINITMACRO) { } PUBLIC MACRO Test2() __ATTRIBUTES__(DEINITMACRO) { }');
  MustContainError(3, errors, 21);
  errors := TestCompile('<?wh PUBLIC MACRO Test1() __ATTRIBUTES__(DEINITMACRO) { } PUBLIC MACRO Test2() __ATTRIBUTES__(DEINITMACRO) { }');
  MustContainError(4, errors, 21);

  result := TestCompileAndRun('<?wh PUBLIC MACRO Test1() __ATTRIBUTES__(DEINITMACRO) { PRINT ("Testing 1 2 3"); }');
  TestCleanResult(5,result.errors);
  TestEq("Testing 1 2 3", result.output);

  CloseTest("TestLoadlib: DeinitTest");
}

