  , [ pattern := "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)\\10", flags := "", input := "abcdefghijj", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 11, value := "abcdefghijj" ], [ matched := TRUE, start := 0, len := 1, value := "a" ], [ matched := TRUE, start := 1, len := 1, value := "b" ], [ matched := TRUE, start := 2, len := 1, value := "c" ], [ matched := TRUE, start := 3, len := 1, value := "d" ], [ matched := TRUE, start := 4, len := 1, value := "e" ], [ matched := TRUE, start := 5, len := 1, value := "f" ], [ matched := TRUE, start := 6, len := 1, value := "g" ], [ matched := TRUE, start := 7, len := 1, value := "h" ], [ matched := TRUE, start := 8, len := 1, value := "i" ], [ matched := TRUE, start := 9, len := 1, value := "j" ] ] ]
  , [ pattern := "[\\1]", flags := "", input := "\x01", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 1, value := "\x01" ] ] ]
  , [ pattern := "[\\8]", flags := "", input := "8", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 1, value := "8" ] ] ]
  , [ pattern := "[\\477]+", flags := "", input := "'7", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 2, value := "'7" ] ] ]
  , [ pattern := "[\\B]", flags := "", input := "B", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 1, value := "B" ] ] ]
  , [ pattern := "[\\w-a]+", flags := "", input := "-a_", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 3, value := "-a_" ] ] ]
  , [ pattern := "[a-\\d]+", flags := "", input := "a-1", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 3, value := "a-1" ] ] ]
  , [ pattern := "[\\s-\\uFFFF]+", flags := "", input := "＀ -￿", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 3, len := 5, value := " -￿" ] ] ]
  , [ pattern := "[\\s-a-z]+", flags := "", input := "b-az", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 1, len := 3, value := "-az" ] ] ]
  , [ pattern := "[\\d-a-z]", flags := "", input := "m", lastindex := 0, expectlastindex := 0, expect := DEFAULT RECORD ARRAY ]
  , [ pattern := "[\\d-a-z]+", flags := "", input := "m1-az", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 1, len := 4, value := "1-az" ] ] ]
  , [ pattern := "[a-b-\\s]+", flags := "", input := "c-ab ", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 1, len := 4, value := "-ab " ] ] ]
  , [ pattern := "[a-b-\\s]+", flags := "u", input := "c-ab ", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 1, len := 4, value := "-ab " ] ] ]
  , [ pattern := "[-\\s]+", flags := "u", input := "x- ", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 1, len := 2, value := "- " ] ] ]
  , [ pattern := "[\\s-]+", flags := "u", input := "x- ", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 1, len := 2, value := "- " ] ] ]
  , [ pattern := "[--a]+", flags := "u", input := "-Aa", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 3, value := "-Aa" ] ] ]
  , [ pattern := "[é-ü]+", flags := "u", input := "aéñü", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 1, len := 6, value := "éñü" ] ] ]
  , [ pattern := "(?=a)*b", flags := "", input := "b", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 1, value := "b" ] ] ]
  , [ pattern := "(?=a){2}a", flags := "", input := "a", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 1, value := "a" ] ] ]
  , [ pattern := "[\\c1]", flags := "", input := "\x11", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 1, value := "\x11" ] ] ]
  , [ pattern := "[\\c_]", flags := "", input := "\x1F", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 1, value := "\x1F" ] ] ]
  , [ pattern := "\\c1", flags := "", input := "\\c1", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 3, value := "\\c1" ] ] ]
  , [ pattern := "\\-\\\"\\@", flags := "", input := "-\"@", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 3, value := "-\"@" ] ] ]
  , [ pattern := "\\(?<x", flags := "", input := "<x", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 0, len := 2, value := "<x" ] ] ]
  , [ pattern := "[(?<=]+", flags := "", input := "a(?<=", lastindex := 0, expectlastindex := 0, expect := [ [ matched := TRUE, start := 1, len := 4, value := "(?<=" ] ] ]
  ];

RECORD ARRAY ecmascript_replace_cases :=
  [ [ pattern := "x*", flags := "g", input := "abc", replacement := "-", expect := "-a-b-c-", expectcallback := "<>a<>b<>c<>" ]
  , [ pattern := "", flags := "g", input := "aé", replacement := "-", expect := "-a-é-", expectcallback := "<>a<>é<>" ]
  , [ pattern := "b", flags := "", input := "abcb", replacement := "[$&]", expect := "a[b]cb", expectcallback := "a<b>cb" ]
  , [ pattern := "b", flags := "", input := "abcb", replacement := "[$`]", expect := "a[a]cb", expectcallback := "a<b>cb" ]
  , [ pattern := "b", flags := "", input := "abcb", replacement := "[$']", expect := "a[cb]cb", expectcallback := "a<b>cb" ]
  , [ pattern := "b", flags := "g", input := "abcb", replacement := "$$", expect := "a$c$", expectcallback := "a<b>c<b>" ]
  , [ pattern := "(b)", flags := "", input := "abc", replacement := "$1$2$0$01", expect := "ab$2$0bc", expectcallback := "a<b>c" ]
  , [ pattern := "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)", flags := "", input := "abcdefghij", replacement := "$10|$11|$010", expect := "j|a1|a0", expectcallback := "<abcdefghij>" ]
  , [ pattern := "(a)", flags := "", input := "abc", replacement := "$10", expect := "a0bc", expectcallback := "<a>bc" ]
  , [ pattern := "(b)", flags := "", input := "abc", replacement := "[$<x>]", expect := "a[$<x>]c", expectcallback := "a<b>c" ]
  , [ pattern := "^", flags := "gm", input := "a\nb", replacement := ">", expect := ">a\n>b", expectcallback := "<>a\n<>b" ]
  , [ pattern := "^", flags := "gm", input := "a\n", replacement := ">", expect := ">a\n>", expectcallback := "<>a\n<>" ]
  , [ pattern := "^$", flags := "gm", input := "a\n\n", replacement := "E", expect := "a\nE\nE", expectcallback := "a\n<>\n<>" ]
  , [ pattern := "$", flags := "gm", input := "a\n", replacement := "<", expect := "a<\n<", expectcallback := "a<>\n<>" ]
  , [ pattern := "$", flags := "g", input := "a\n", replacement := "<", expect := "a\n<", expectcallback := "a\n<>" ]
  , [ pattern := "é", flags := "gi", input := "ÉéE", replacement := "e", expect := "eeE", expectcallback := "<É><é>E" ]
  , [ pattern := ".", flags := "", input := "😀a", replacement := "x", expect := "xa", expectcallback := "<😀>a" ]
  , [ pattern := "", flags := "g", input := "a😀", replacement := "-", expect := "-a-😀-", expectcallback := "<>a<>😀<>" ]
  , [ pattern := ".", flags := "g", input := "😀é", replacement := "<$&>", expect := "<😀><é>", expectcallback := "<😀><é>" ]
  , [ pattern := ".", flags := "g", input := "😀x", replacement := "-", expect := "--", expectcallback := "<😀><x>" ]
  ];

RECORD ARRAY ecmascript_error_cases :=
  [ [ pattern := "(", flags := "" ]
  , [ pattern := "a**", flags := "" ]
  , [ pattern := "a*+", flags := "" ]
  , [ pattern := "a++", flags := "" ]
  , [ pattern := "a{2}+", flags := "" ]
  , [ pattern := "(?>a)", flags := "" ]
  , [ pattern := "(?|a)", flags := "" ]
  , [ pattern := "(?#comment)", flags := "" ]
  , [ pattern := "(?(1)a)", flags := "" ]
  , [ pattern := "(?R)", flags := "" ]
  , [ pattern := "(?1)", flags := "" ]
  , [ pattern := "(?P<n>a)", flags := "" ]
  , [ pattern := "(?&n)", flags := "" ]
  , [ pattern := "(*FAIL)", flags := "" ]
  , [ pattern := "(?x)a", flags := "" ]
  , [ pattern := "(?i)a", flags := "" ]
  , [ pattern := "a", flags := "v" ]
  , [ pattern := "a", flags := "gg" ]
  , [ pattern := "a", flags := "x" ]
  , [ pattern := "\\", flags := "" ]
  , [ pattern := "(?<x>a)", flags := "" ]
  , [ pattern := "(?<x>a)\\k<x>", flags := "" ]
  , [ pattern := "a|(b(?<x>c))", flags := "g" ]
  , [ pattern := "(?<=a)b", flags := "" ]
  , [ pattern := "(?<!a)b", flags := "" ]
  , [ pattern := "a|((?<=a)b)", flags := "g" ]
  , [ pattern := "(?i:a)b", flags := "" ]
  , [ pattern := "(?-i:a)b", flags := "i" ]
  , [ pattern := "(?s:a.b)", flags := "" ]
  , [ pattern := "a", flags := "d" ]
  , [ pattern := "a", flags := "s" ]
  , [ pattern := "\\A", flags := "u" ]
  , [ pattern := "\\Q", flags := "u" ]
  , [ pattern := "\\x4", flags := "u" ]
  , [ pattern := "\\u{110000}", flags := "u" ]
  , [ pattern := "\\u{}", flags := "u" ]
  , [ pattern := "\\u{1234567}", flags := "u" ]
  , [ pattern := "\\u{12G}", flags := "u" ]
  , [ pattern := "a{", flags := "u" ]
  , [ pattern := "]", flags := "u" ]
  , [ pattern := "\\p", flags := "u" ]
  , [ pattern := "\\k<x>", flags := "u" ]
  , [ pattern := "\\1", flags := "u" ]
  , [ pattern := "\\8", flags := "u" ]
  , [ pattern := "\\2(a)", flags := "u" ]
  , [ pattern := "[\\s-\\uFFFF]", flags := "u" ]
  , [ pattern := "[\\x00-\\s]", flags := "u" ]
  , [ pattern := "[\\w-a]", flags := "u" ]
  , [ pattern := "[a-\\d]", flags := "u" ]
  , [ pattern := "[\\s--]", flags := "u" ]
  , [ pattern := "[\\p{L}-z]", flags := "u" ]
  , [ pattern := "a", flags := "y" ]
  ];

STRING FUNCTION WrapMatch(STRING match, STRING ARRAY params, INTEGER pos, STRING input) {
  RETURN "<" || match || ">";
}

STRING FUNCTION ReuseRegExInCallback(OBJECT re, STRING match, STRING ARRAY params, INTEGER pos, STRING input) {
  // Use the regex that is running the ReplaceCallback, which moves or resets its lastindex
  re->Test(input);
  re->Exec(input);
  re->Replace(input, "x");
  RETURN re->ReplaceCallback(match, PTR WrapMatch);
}

BOOLEAN FUNCTION CompileAndTest(STRING pattern, STRING flags) {
  RETURN NEW RegEx(pattern, flags)->Test("");
}

MACRO ECMAScriptCompatTest() {
  OpenTest("TestRegex: ECMAScriptCompatTest");

  FOREVERY (RECORD testcase FROM ecmascript_exec_cases) {
    STRING annotation := `/${testcase.pattern}/${testcase.flags} on ${EncodeJava(testcase.input)} from ${testcase.lastindex}`;
    OBJECT re := NEW RegEx(testcase.pattern, testcase.flags);
    re->lastindex := testcase.lastindex;
    TestEQ(testcase.expect, re->Exec(testcase.input), annotation);
    TestEQ(testcase.expectlastindex, re->lastindex, annotation || " (lastindex)");
  }

  FOREVERY (RECORD testcase FROM ecmascript_replace_cases) {
    STRING annotation := `/${testcase.pattern}/${testcase.flags} on ${EncodeJava(testcase.input)} with ${EncodeJava(testcase.replacement)}`;
    TestEQ(testcase.expect, NEW RegEx(testcase.pattern, testcase.flags)->Replace(testcase.input, testcase.replacement), annotation);
    TestEQ(testcase.expectcallback, NEW RegEx(testcase.pattern, testcase.flags)->ReplaceCallback(testcase.input, PTR WrapMatch), annotation || " (callback)");
  }

  FOREVERY (RECORD testcase FROM ecmascript_error_cases)
    TestThrowsLike("*regular expression*", PTR CompileAndTest(testcase.pattern, testcase.flags), `/${testcase.pattern}/${testcase.flags}`);

  // Flags and properties
  OBJECT re := NEW RegEx("a", "umig");
  TestEQ("a", re->source);
  TestEQ(TRUE, re->global AND re->ignorecase AND re->multiline AND re->unicode);
  re->global := FALSE;
  TestEQ("BA", re->Replace("AA", "B"));

  // lastindex is ignored (and not updated) for non-global regexes
  re := NEW RegEx("b");
  re->lastindex := 2;
  TestEQ(1, re->Exec("abc")[0].start);
  TestEQ(2, re->lastindex);

  // A lastindex inside a character continues at the next character
  FOREVERY (INTEGER startpos FROM [ 1, 2, 3 ]) {
    re := NEW RegEx(".", "g");
    re->lastindex := startpos;
    TestEQ([ [ matched := TRUE, start := 4, len := 1, value := "x" ] ], re->Exec("😀x"), `lastindex ${startpos}`);
    TestEQ(5, re->lastindex);
  }
  re := NEW RegEx(".", "g");
  re->lastindex := 1;
  TestEQ([ [ matched := TRUE, start := 2, len := 1, value := "x" ] ], re->Exec("éx"));

  // A non-global ReplaceCallback only replaces the first match
  TestEQ("<b>cb", NEW RegEx("b")->ReplaceCallback("bcb", PTR WrapMatch));
  TestEQ("<b>c<b>", NEW RegEx("b", "g")->ReplaceCallback("bcb", PTR WrapMatch));

  // ReplaceCallback doesn't depend on lastindex, so the callback can use the same regex
  re := NEW RegEx("b", "g");
  re->lastindex := 2;
  TestEQ("<b>c<b>c<b>", re->ReplaceCallback("bcbcb", PTR ReuseRegExInCallback(re, #1, #2, #3, #4)));
  TestEQ(0, re->lastindex);
  re := NEW RegEx("b");
  TestEQ("<b>cb", re->ReplaceCallback("bcb", PTR ReuseRegExInCallback(re, #1, #2, #3, #4)));

  // JSRegEx is still available (but deprecated)
  TestEQ("a-b", NEW JSRegEx("\\s+", "g")->Replace("a \n b", "-"));

  CloseTest("TestRegex: ECMAScriptCompatTest");
}

RegExTest();
ReplaceTest();
ReplaceCallbackTest();
LikeRegexPatternTest();
ECMAScriptCompatTest();
