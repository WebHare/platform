<?wh
LOADLIB "wh::internet/urls.whlib";

LOADLIB "mod::tollium/lib/screenbase.whlib";

LOADLIB "mod::wrd/lib/screenbase.whlib";


PUBLIC STATIC OBJECTTYPE Forges EXTEND TolliumScreenBase
<
>;


PUBLIC STATIC OBJECTTYPE EditForge EXTEND WRDEntityEditScreenBase
<
  MACRO OnOpenNewToken(OBJECT browser) {
    STRING forgeurl := ^entity->^url->value;
    IF (ToLowercase(UnpackURL(forgeurl).host) = "github.com") {
      /* Fine-grained token with what a GitHub equivalent of automerge needs: create/find PRs and set assignees (pull_requests),
         merge or enable auto-merge (contents), and check CI results (actions). metadata:read is implied */
      browser->SendURL("https://github.com/settings/personal-access-tokens/new?name=WebHare+devkit"
                       || "&description=" || EncodeURL("Used by WebHare devkit:automerge")
                       || "&contents=write&pull_requests=write&actions=read");
      RETURN;
    }
    browser->SendURL(forgeurl || "/-/user_settings/personal_access_tokens/");
  }
>;
