<screens xmlns="http://www.webhare.net/xmlns/tollium/screens"
         xmlns:wrd="http://www.webhare.net/xmlns/wrd/components"
         gid="tolliumapps.deploy.forges"
         library="forges.whlib">

  <screen name="forges" footerbuttons="close">
    <body>
      <wrd:entitiesedit name="forges" minwidth="60x" minheight="4gr" entityeditscreen="#editforge" wrdtype="forge">
        <column name="url" type="text" />
      </wrd:entitiesedit>
    </body>
  </screen>

  <screen name="editforge" footerbuttons="ok cancel">
    <actions>
      <windowopenaction name="opennewtoken" onwindowopen="onopennewtoken" title="" />
    </actions>

    <compositions>
      <wrd:entity name="entity" />
    </compositions>

    <body>
      <line layout="left">
        <text name="abouttoken" title="" wordwrap="true" />
      </line>
      <textedit name="url" composition="entity" cellname="url" required="true" onchange="onurlchange" />
      <textedit name="token" composition="entity" cellname="token" required="true" />
      <textedit name="resourceowner" placeholdertid=".resourceownerplaceholder" />
      <line layout="left">
        <text name="aboutresourceowner" title="" valuetid=".aboutresourceowner" wordwrap="true" />
      </line>
      <line layout="right">
        <text name="requestnewttoken" action="opennewtoken" title="" valuetid=".requestnewtoken" />
      </line>
    </body>
  </screen>

</screens>
