<?wh
LOADLIB "wh::javascript.whlib";
LOADLIB "wh::os.whlib";

LOADLIB "mod::system/lib/configure.whlib";
LOADLIB "mod::system/lib/resources.whlib";


PUBLIC RECORD FUNCTION SpawnProcessSync(STRING cmd, STRING ARRAY args, RECORD options DEFAULTSTO DEFAULT RECORD) {
  options := ValidateOptions(CELL[ use_wh_run := FALSE ], options);

  IF(options.use_wh_run) {
    args := [ "run", GetWebHareResourceDiskPath(cmd), ...args ];
    cmd := `${GetWebHareConfiguration().installationroot}/bin/wh`;
  }

  IF(IsWasm())
    RETURN CallJS("mod::platform/js/harescript/process.ts#spawnProcessSync", cmd, args);

  OBJECT process;
  TRY {
    process := CreateProcess(cmd, args, [ take_output := TRUE, take_errors := TRUE, merge_output_errors := TRUE ]);

    process->Start();

    STRING output;
    INTEGER exitcode := -1;
    OBJECT itr := MakeProcessAsyncIterator(process, [ autoclose := FALSE ]);
    WHILE (TRUE) {
      RECORD rec := WaitForPromise(itr->Next());
      IF (rec.done)
        BREAK;
      SWITCH (rec.value.type) {
        CASE "output"   { output := output || rec.value.line || "\n"; }
        CASE "close"    { exitcode := rec.value.exitcode; }
      }
    }

    RETURN CELL[ error := exitcode != 0, exitcode, output ];
  } FINALLY {
    process->Close();
  }
}
