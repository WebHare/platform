<?wh

LOADLIB "wh::javascript.whlib";

LOADLIB "mod::tollium/lib/dialogs.whlib";
LOADLIB "mod::tollium/lib/gettid.whlib";


PUBLIC MACRO RunShareApplicationLinkDialog(OBJECT opener, STRING link, RECORD options DEFAULTSTO DEFAULT RECORD) {
  options := ValidateOptions(CELL[], options);
  opener->RunScreen("mod::platform/tolliumapps/applicationlink/applicationlink.xml#sharelink", CELL [ link ]);
}

PUBLIC MACRO RunManageOIDCProvidersDialog(OBJECT opener, RECORD options DEFAULTSTO DEFAULT RECORD) {
  options := ValidateOptions(CELL[ wrdschema := DEFAULT OBJECT], options);

  OBJECT wrdschema := options.wrdschema ?? opener->contexts->wrdschema;
  IF(NOT ObjectExists(wrdschema) OR NOT ObjectExists(wrdschema->GetType("wrdauth_server"))) {
    opener->RunSimpleScreen("error", GetTid("wrd:browser.main.oidcclient-not-configured"));
    RETURN;
  }

  opener->RunScreen("mod::wrd/tolliumapps/oidc/client.xml#providers", CELL [], CELL[ contexts := CELL[ wrdschema ]]);
}

/** Configure, generate and download a report declared in a moduledefinition's `reports`
    @param opener Screen (or controller) to open the dialogs from
    @param reportname Full module:report name of the report
    @param params Initial parameters for the report. Passed to the report's configScreen (as params) and onGenerate
    @return TRUE if the report was generated and the export dialog was completed */
PUBLIC BOOLEAN FUNCTION RunReportDialog(OBJECT opener, STRING reportname, RECORD params DEFAULTSTO DEFAULT RECORD) {
  RECORD report := CallJS([ camelcase := TRUE ], "mod::platform/js/reports/reports.ts#getReport", reportname);

  RECORD settings;
  IF(report.config_screen != "") {
    settings := opener->RunScreen(report.config_screen, CELL[ params ]);
    IF(NOT RecordExists(settings))
      RETURN FALSE;
  }

  RECORD reportdata := CallJS([ camelcase := TRUE ], "mod::platform/js/reports/reports.ts#generateReport", reportname, params, settings, CELL[ lang_code := GetTidLanguage() ]);
  RETURN RunColumnFileExportDialog(opener, reportdata);
}
