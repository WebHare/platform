<?wh

LOADLIB "mod::system/lib/configure.whlib";

LOADLIB "mod::wrd/lib/internal/wrdsettings.whlib";

PUBLIC RECORD FUNCTION RenameSP(OBJECT wrdschema) {
  OBJECT wrdauth_service_provider := wrdschema->GetType("wrdauth_service_provider");
  IF(ObjectExists(wrdauth_service_provider))
    wrdauth_service_provider->UpdateMetadata(CELL[ tag := "wrdauth_application" ]);
  RETURN DEFAULT RECORD;
}

PUBLIC RECORD FUNCTION RenameOIDCClient(OBJECT wrdschema) {
  OBJECT wrdauth_oidc_client := wrdschema->GetType("wrdauth_oidc_client");
  IF(ObjectExists(wrdauth_oidc_client)) {
    wrdauth_oidc_client->UpdateMetadata(CELL[ tag := "wrdauth_server" ]);

    //We also add an 'is_idp' attribute to explicitly mark the upstream servers we recognize as an IDP
    wrdauth_oidc_client->CreateAttribute("IS_IDP", "BOOLEAN");
    FOREVERY(RECORD client FROM wrdauth_oidc_client->RunQuery([ outputcolumns := CELL["wrd_id"] ]))
      wrdauth_oidc_client->UpdateEntity(client.wrd_id, CELL[ is_idp := TRUE ]);
  }

  RETURN DEFAULT RECORD;
}

PUBLIC RECORD FUNCTION MigrateOIDCServerAttributes(OBJECT wrdschema) {
  OBJECT server_type := wrdschema->GetType("wrdauth_server");
  IF(NOT ObjectExists(server_type))
    RETURN DEFAULT RECORD;

  FOREVERY(RECORD attribute FROM [[ oldtag := "clientid", newtag := "client_id" ]
                                , [ oldtag := "metadataurl", newtag := "metadata_url" ]
                                , [ oldtag := "additionalscopes", newtag := "additional_scopes" ]
                                , [ oldtag := "loginfield", newtag := "login_field" ]])
    IF(RecordExists(server_type->GetAttribute(attribute.oldtag)))
      server_type->UpdateAttribute(attribute.oldtag, CELL[ tag := attribute.newtag ]);

  IF(RecordExists(server_type->GetAttribute("clientsecret"))) {
    IF(NOT RecordExists(server_type->GetAttribute("client_signing")))
      server_type->CreateAttribute("client_signing", "JSON", CELL[ isunsafetocopy := TRUE ]);

    FOREVERY(RECORD server FROM server_type->RunQuery(CELL[ outputcolumns := CELL[ "wrd_id", "clientsecret" ], historymode := "all" ]))
      IF(server.clientsecret != "")
        server_type->UpdateEntity(server.wrd_id, CELL[ client_signing := CELL[ type := "client_secret", secret := server.clientsecret ] ]);

    server_type->DeleteAttribute("clientsecret");
  }

  RETURN DEFAULT RECORD;
}

/* Change linkfrom of whuser_appaccount and whuser_peerserver from wrd_relation to wrd_person. UpdateSchema refuses to change
   the left type of a type that has entities, so we do it ourselves before the types are updated */
PUBLIC RECORD FUNCTION MigrateUserAttachmentsToPerson(OBJECT wrdschema) {
  OBJECT persontype := wrdschema->GetType("wrd_person");
  IF(NOT ObjectExists(persontype))
    RETURN DEFAULT RECORD;

  RECORD result;
  FOREVERY(STRING typetag FROM [ "whuser_appaccount", "whuser_peerserver" ]) {
    OBJECT attachmenttype := wrdschema->GetType(typetag);
    IF(NOT ObjectExists(attachmenttype) OR attachmenttype->linkfrom = persontype->id)
      CONTINUE;

    RECORD ARRAY entities := attachmenttype->RunQuery(CELL[ outputcolumns := CELL[ "wrd_id", "wrd_leftentity" ], historymode := "all" ]);
    INTEGER ARRAY personids := SELECT AS INTEGER ARRAY wrd_id
                                 FROM persontype->RunQuery(CELL[ outputcolumns := CELL[ "wrd_id" ]
                                                               , filters := [[ field := "wrd_id", matchtype := "IN", value := SELECT AS INTEGER ARRAY DISTINCT wrd_leftentity FROM entities ]]
                                                               , historymode := "all"
                                                               ]);

    //These should never exist (they're always created for users), but we can't keep them when requiring wrd_person
    INTEGER ARRAY nonpersonentities := SELECT AS INTEGER ARRAY wrd_id FROM entities WHERE wrd_leftentity NOT IN personids;
    IF(Length(nonpersonentities) > 0)
      attachmenttype->DeleteEntities(nonpersonentities);

    attachmenttype->UpdateMetadata(CELL[ linkfrom := persontype->id ]);
    result := CellInsert(result, typetag, CELL[ total := Length(entities), deleted := Length(nonpersonentities) ]);
  }

  RETURN result;
}

/* The configurable OpenID issuer is replaced by an issuer derived from the identity provider site. Schemas which had an
   issuer configured were acting as OpenID Connect provider, so set login_settings.open_id_server for them. We delete the
   issuer attribute ourselves so we don't depend on the order of this migration and the metadata update */
PUBLIC RECORD FUNCTION MigrateOpenIDIssuer(OBJECT wrdschema) {
  OBJECT settingstype := wrdschema->GetType("wrd_settings");
  IF(NOT ObjectExists(settingstype) OR NOT RecordExists(settingstype->GetAttribute("issuer")))
    RETURN DEFAULT RECORD;

  INTEGER settingsentity := settingstype->Search("wrd_guid", wrd_settings_guid, [ historymode := "all" ]);
  RECORD result := CELL[ openidserver := FALSE ];
  IF(settingsentity != 0) {
    RECORD cursettings := settingstype->GetEntityFields(settingsentity, [ "issuer", "login_settings" ]);
    IF(cursettings.issuer != "") {
      settingstype->UpdateEntity(settingsentity, CELL[ login_settings := CELL[ ...cursettings.login_settings, open_id_server := TRUE ] ]);
      result := CELL[ openidserver := TRUE, oldissuer := cursettings.issuer ];
    }
  }

  settingstype->DeleteAttribute("issuer");
  RETURN result;
}

PUBLIC RECORD FUNCTION MigrateAccountStatus(OBJECT wrdschema) {
  IF(NOT RecordExists(wrdschema->^wrd_person->GetAttribute("whuser_disabled")))
    RETURN DEFAULT RECORD; //this schema never had whuser_disabled. even though we use at=update this may happen if usermgmt is applied to an already created wrdschema

  /* Transfer whuser_disabled and whuser_disablereason to wrdauth_account_status
     and remove the attributes from wrd_person. Remove whuser_disable_type if already created (april 2023)
  */
  RECORD outputcolumns := CELL[ "wrd_id", "whuser_disablereason", "whuser_disabled" ];
  BOOLEAN has_whuser_disable_type := RecordExists(wrdschema->^wrd_person->GetAttribute("whuser_disable_type"));
  IF(has_whuser_disable_type)
    INSERT CELL whuser_disable_type := "whuser_disable_type" INTO outputcolumns;

  RECORD ARRAY users := wrdschema->^wrd_person->RunQuery(CELL [outputcolumns, historymode := "all"]);
  INTEGER numinactive, numactive, numblocked;

  FOREVERY(RECORD user FROM users) {
    RECORD set_accountstatus;
    IF(user.whuser_disabled)
      IF(has_whuser_disable_type AND user.whuser_disable_type = "inactive") {
        set_accountstatus := CELL[ status := "inactive" ];
        numinactive := numinactive + 1;
      } ELSE {
        set_accountstatus := CELL[ status := "blocked", reason := user.whuser_disablereason ];
        numblocked := numblocked + 1;
      }
    ELSE {
      set_accountstatus := CELL[ status := "active" ];
      numactive := numactive + 1;
    }

    wrdschema->^wrd_person->UpdateEntity(user.wrd_id, CELL[ wrdauth_account_status := set_accountstatus ]);
  }

  wrdschema->^wrd_person->DeleteAttribute("whuser_disabled");
  wrdschema->^wrd_person->DeleteAttribute("whuser_disablereason");
  IF(has_whuser_disable_type)
    wrdschema->^wrd_person->DeleteAttribute("whuser_disable_type");

  RETURN CELL[ numinactive, numactive, numblocked ];
}

PUBLIC RECORD FUNCTION MigrateMailServers(OBJECT wrdschema) {
  IF(NOT RecordExists(wrdschema->^mailroute->GetAttribute("serverurl")))
    RETURN DEFAULT RECORD; //nothing to migrate

  RECORD ARRAY servermapping;
  RECORD ARRAY currentroutes := wrdschema->^mailroute->RunQuery([outputcolumns := CELL[ "wrd_id", "serverurl" ]]);
  STRING defaultroute := ReadRegistryKey("system.services.smtp.defaultmailroute", [ fallback := "" ]);
  INTEGER defaultrouteid;

  IF(defaultroute != "")
    defaultrouteid := wrdschema->^mailserver->CreateEntity(CELL[wrd_title := "Default route",  serverurl := defaultroute, wrd_tag := "DEFAULTSERVER" ])->id;

  DeleteRegistryKey("system.services.smtp.defaultmailroute");

  FOREVERY(RECORD route FROM currentroutes) {
    IF(route.serverurl = "null") //blackhole
      wrdschema->^mailroute->UpdateEntity(route.wrd_id, CELL[ rewritemailaddress := "null" ]);
    ELSE {
      INTEGER newserver := defaultrouteid;
      IF(route.serverurl != "") {
        newserver := wrdschema->^mailserver->Search("serverurl", route.serverurl);
        IF(newserver = 0)
          newserver := wrdschema->^mailserver->CreateEntity(CELL[ wrd_title := "Mailserver #" || Length(wrdschema->^mailserver->RunQuery(CELL[])) + 1, serverurl := route.serverurl ])->id;
        ELSE
          print('reuse server ' || newserver ||'\n');
      }
      wrdschema->^mailroute->UpdateEntity(route.wrd_id, CELL[ server := newserver ]);
    }
  }

  wrdschema->^mailroute->DeleteAttribute("serverurl"); //not backing up as it may contain passwords

  RETURN DEFAULT RECORD;
}
