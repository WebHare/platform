<?wh

LOADLIB "wh::internet/urls.whlib";
LOADLIB "wh::xml/xsd.whlib";

LOADLIB "mod::publisher/lib/publisher.whlib";
LOADLIB "mod::system/lib/database.whlib";
LOADLIB "mod::system/lib/internal/webhareconstants.whlib";
LOADLIB "mod::system/lib/internal/cache/imgcache.whlib";
LOADLIB "mod::system/lib/resources.whlib";
LOADLIB "mod::tollium/lib/componentbase.whlib";
LOADLIB "mod::tollium/lib/screenbase.whlib";
LOADLIB "mod::tollium/lib/internal/inputvalidation.whlib";

/* URL paths that are WebHare internals: caches, previews, resources, downloads, sessions and APIs. They may expire,
   change, be tied to a session or expose a copy of a file stored elsewhere, so they aren't suitable as an external link.
   We deliberately don't check the host: this also catches links to other WebHare servers such as test environments.
   In time this list should shrink to just '.wh/' */
CONSTANT STRING ARRAY webhare_internal_paths := [ ".wh/", ".uc/", ".publisher/", ".system/" ];

/// Get the path of an absolute, protocol-relative or root-relative URL, without the leading slash
STRING FUNCTION GetLinkPath(STRING url) {
  IF(Left(url, 2) = "//")
    RETURN UnpackURL("https:" || url).urlpath;
  IF(Left(url, 1) = "/")
    RETURN Substring(url, 1);
  IF(IsAbsoluteURL(url))
    RETURN UnpackURL(url).urlpath;
  RETURN "";
}

/// Get the source of a cache link, or DEFAULT RECORD if it isn't one or its token can't be decoded (as LookupPublisherURL does)
RECORD FUNCTION GetCachedSourceForLink(STRING url) {
  TRY {
    RETURN GetCachedDataSourceMetadataFromURL(url);
  } CATCH {
    RETURN DEFAULT RECORD;
  }
}

/// Is this a cache link to a file that isn't a WHFS object itself (and thus can't be converted to an internal link)?
BOOLEAN FUNCTION IsCachedAttachmentLink(STRING url) {
  RECORD src := GetCachedSourceForLink(url);
  RETURN RecordExists(src) AND src.type != 1;
}

/** Get the error to show for an external link to a WebHare internal URL
    @param url URL to check
    @param fieldtitle Title of the field for the error message
    @return Error message, or an empty string if the URL is acceptable */
STRING FUNCTION GetWebHareInternalLinkError(STRING url, STRING fieldtitle) {
  STRING path := ToUppercase(GetLinkPath(url));
  BOOLEAN isinternal;
  FOREVERY(STRING prefix FROM webhare_internal_paths)
    IF(path LIKE ToUppercase(prefix) || "*")
      isinternal := TRUE;
  IF(NOT isinternal)
    RETURN "";

  //Try to tell the user where the file came from so they can link to it directly
  RECORD src := GetCachedSourceForLink(url);
  IF(RecordExists(src) AND src.type = 1) { //a WHFS object (eg a file in the Publisher)
    STRING sourcepath := SELECT AS STRING whfspath FROM system.fs_objects WHERE id = src.id AND isactive;
    IF(sourcepath != "")
      RETURN GetTid("publisher:components.errors.cachedfilelink", fieldtitle, sourcepath);
  } ELSE IF(RecordExists(src) AND src.type = 2) { //a file stored in a WHFS object's field (eg a widget's attachment)
    STRING sourcepath := SELECT AS STRING fs_objects.whfspath
                         FROM system.fs_settings, system.fs_instances, system.fs_objects
                        WHERE fs_settings.id = src.id
                              AND fs_settings.fs_instance = fs_instances.id
                              AND fs_instances.fs_object = fs_objects.id
                              AND fs_objects.isactive;
    IF(sourcepath != "")
      RETURN GetTid("publisher:components.errors.cachedattachmentlink", fieldtitle, sourcepath);
  } ELSE IF(path LIKE ".PUBLISHER/PREVIEW/*" AND IsAbsoluteURL(url)) {
    RECORD match := LookupPublisherURL(url);
    INTEGER target := match.__directfile ?? match.folder;
    IF(match.ispreview AND target != 0)
      RETURN GetTid("publisher:components.errors.previewlink", fieldtitle, SELECT AS STRING whfspath FROM system.fs_objects WHERE id = target);
  }

  RETURN GetTid("publisher:components.errors.webhareinternallink", fieldtitle);
}

MACRO ExpandHyperlinkComponents(OBJECT selectbox)
{
  FOREVERY(RECORD opt FROM selectbox->options)
  {
    OBJECT insertpos := selectbox->GetButtoncomponent(opt.rowkey);

    FOREVERY(OBJECT comp FROM opt.enablecomponents)
    {
      selectbox->parentpanel->InsertComponentAfter(comp, insertpos, FALSE);
      insertpos := comp;
    }
  }
}


PUBLIC OBJECTTYPE IntExtLink EXTEND TolliumFragmentBase <
  // ---------------------------------------------------------------------------
  //
  // Variables
  //

  INTEGER current_linktype;

  OBJECT ARRAY __linkhandlers; //internal link <linkhandlers> object

  STRING ARRAY __linktypes;

  // Objects created to implement the __linktypes
  RECORD __linktypeshandlers;

  RECORD ARRAY originaloptions;
  OBJECT ARRAY handlercomponents;

  BOOLEAN __internallinks;
  BOOLEAN suspendonchange;
  RECORD lastnotifiedvalue;

  /* External link last set through 'value'. Existing content is accepted as is, so we only reject links to WebHare
     internal URLs if the user entered them */
  STRING acceptedexternallink;

  // ---------------------------------------------------------------------------
  //
  // Public variables and properties
  //

  /// Value
  PUBLIC PROPERTY value(GetValue, SetValue);

  PUBLIC MACRO PTR onchange;

  /// Title
  UPDATE PUBLIC PROPERTY title(^linkblock->title, ^linkblock->title); //the inlineblock carries the title so the parent line renders it in its label column

  PUBLIC PROPERTY linkhandlers(__linkhandlers, SetLinkHandlers);

  PUBLIC PROPERTY linktypes(__linktypes, SetLinkTypes);

  PUBLIC PROPERTY internallinks(__internallinks, SetInternalLinks);

  /// @type(integer array) Limit the root folders for internal links in the browse dialog, leave empty to show all accessible folders
  PUBLIC PROPERTY internallinkroots(^internal->roots, ^internal->roots);

  // ---------------------------------------------------------------------------
  //
  // Constructor
  //

  PUBLIC MACRO NEW()
  {
    EXTEND this BY TolliumIsComposable;
    EXTEND this BY TolliumIsDirtyable;

    this->__internallinks := TRUE;
  }

  // ---------------------------------------------------------------------------
  //
  // Tollium admin stuff
  //

  UPDATE PUBLIC MACRO StaticInit(RECORD def)
  {
    TolliumFragmentBase::StaticInit(def);
    this->title := def.title;
    this->onchange := def.onchange;
    this->__internallinks := def.internallinks;
    IF(ObjectExists(def.linkhandlers))
      this->linkhandlers := def.linkhandlers->linkhandlers;

    this->__linktypes := ParseXSList(def.linktypes);

    this->ConfigureOptions();
  }

  UPDATE PUBLIC MACRO PreInitComponent()
  {
    IF(Length(this->originaloptions) = 0)
      this->ConfigureOptions();
  }

  MACRO ConfigureOptions()
  {
    IF(Length(this->originaloptions) = 0)
      this->originaloptions := ^linktype->options;

    RECORD ARRAY opts := this->originaloptions;
    IF(this->pvt_required)
      DELETE FROM opts WHERE rowkey = 0;
    IF(NOT this->__internallinks)
      DELETE FROM opts WHERE rowkey = 2;

    OBJECT ARRAY linktypehandlers;
    FOREVERY(STRING linktype FROM this->__linktypes) {
      IF(NOT CellExists(this->__linktypeshandlers, linktype)) {
        RECORD handler := SELECT * FROM __GetExtractedConfig("plugins").link_types WHERE name = linktype;
        IF(NOT RecordExists(handler))
          THROW NEW Exception(`Link type '${linktype}' configured for IntExtLink component, but no handler found in configuration`);

        OBJECT handlercomp := this->owner->CreateDynamicComponent(handler.tollium_component);
        this->__linktypeshandlers := CellInsert(this->__linktypeshandlers, linktype, handlercomp);
      }
      INSERT GetCell(this->__linktypeshandlers, linktype) INTO linktypehandlers AT END;
    }

    //FIXME: When deleting and recreating handler subcomponents, their current value is lost
    FOREVERY (OBJECT subcomp FROM this->handlercomponents)
      subcomp->DeleteComponent();
    this->handlercomponents := OBJECT[];

    FOREVERY(OBJECT handler FROM linktypehandlers CONCAT this->linkhandlers)
    {
      OBJECT ARRAY components := handler->CreateComponents(this->owner);
      this->handlercomponents := this->handlercomponents CONCAT components;

      INSERT [ rowkey := #handler + 100
             , title := handler->title
             , handler := handler
             , enablecomponents := components
             , tolliumselected := FALSE
             ] INTO opts AT END;
    }
    UPDATE opts SET tolliumselected := TRUE WHERE rowkey = ^linktype->value;
    ^linktype->options := opts;

    ExpandHyperlinkComponents(^linktype);
  }

  // ---------------------------------------------------------------------------
  //
  // Helper functions
  //

  RECORD FUNCTION GetCurrentInternalLinkValue()
  {
    INTEGER objid := ^internal->value;
    IF(objid!=0)
    {
      BOOLEAN valid_append := Left(^append->value, 1) IN whconstant_internallink_startcharacters;
      RETURN MakeIntExtInternalLink(objid, valid_append ? ^append->value : "");
    }
    RETURN DEFAULT RECORD;
  }

  RECORD FUNCTION GetValue()
  {
    RECORD selected := ^linktype->selection;
    IF(NOT RecordExists(selected) OR selected.rowkey = 0) //'no link'
      RETURN DEFAULT RECORD;

    IF(^linktype->value = 2) //internal link
      RETURN this->GetCurrentInternalLinkValue();
    ELSE IF(^linktype->value = 1) //external link
      RETURN MakeIntExtExternalLink(GeneralizeSharedLink(^external->value));

    RETURN selected.handler->GetLinkRecord();
  }

  // ---------------------------------------------------------------------------
  //
  // Getters & setters
  //

  MACRO SetLinkHandlers(OBJECT ARRAY newlinkhandlers)
  {
    this->__linkhandlers := newlinkhandlers;
    IF(Length(this->originaloptions) > 0) //need to reconfig?
      this->ConfigureOptions();
  }

  MACRO SetLinkTypes(STRING ARRAY newlinktypes)
  {
    this->__linktypes := newlinktypes;
    IF(Length(this->originaloptions) > 0) //need to reconfig?
      this->ConfigureOptions();
  }

  MACRO SetInternalLinks(BOOLEAN newinternallinks)
  {
    IF(this->__internallinks = newinternallinks)
      RETURN;

    this->__internallinks := newinternallinks;
    IF(Length(this->originaloptions) > 0) //need to reconfig?
      this->ConfigureOptions();
  }

  UPDATE MACRO SetRequired(BOOLEAN new_required)
  {
    IF(new_required = this->pvt_required)
      RETURN;

    TolliumFragmentBase::SetRequired(new_required);
    this->ConfigureOptions();
  }

  UPDATE MACRO SetEnabled(BOOLEAN nowenable)
  {
    IF(this->pvt_enabled = nowenable)
      RETURN;

    this->pvt_enabled := nowenable;
    ^linktype->enabled := nowenable;
  }

  MACRO SetValue(RECORD value) {
    BOOLEAN wassuspended := this->suspendonchange;
    this->suspendonchange := TRUE;
    TRY {
      this->ApplyValue(value);
    } FINALLY {
      this->suspendonchange := wassuspended;
    }
    this->OnValueChange();
  }

  MACRO ApplyValue(RECORD value) {
    this->EnsurePreInit();
    IF(RecordExists(value) AND value.internallink = 0 AND value.externallink = "") //normalize value
      value := DEFAULT RECORD;
    //Writing back what the user entered (eg from an onchange handler) shouldn't make it acceptable
    STRING newexternallink := RecordExists(value) ? value.externallink : "";
    IF(newexternallink = "" OR newexternallink != ^external->value)
      this->acceptedexternallink := newexternallink;

    IF(EncodeHSON(value) = EncodeHSON(this->GetValue()))
      RETURN; //no change apparently

    IF(NOT RecordExists(value)) {
      ^linktype->value := 0;
      ^internal->value := 0;
      ^append->value := "";
      ^external->value := "";
      RETURN;
    }

    BOOLEAN didset;
    FOREVERY(RECORD opt FROM ^linktype->options) {
      IF(opt.rowkey < 100) //not handling builtins here
        CONTINUE;

      IF(opt.handler->SetLinkRecordIfSupported(value)) {
        didset := TRUE;
        ^linktype->value := opt.rowkey;
        BREAK;
      }
    }

    IF(NOT didset) {
      IF(value.internallink != 0 AND this->internallinks) {
        ^linktype->value := 2;
        ^internal->value := value.internallink;
        ^append->value := value.append;
      } ELSE {
        ^linktype->value := 1; //external link
        ^external->value := value.externallink;
      }
    }
    this->SetDirty();
  }

  // ---------------------------------------------------------------------------
  //
  // Callbacks
  //

  MACRO OnLinkTypeChange() {
    BOOLEAN wassuspended := this->suspendonchange;
    this->suspendonchange := TRUE;
    TRY {
      this->ConvertLinkType();
    } FINALLY {
      this->suspendonchange := wassuspended;
    }
    this->OnValueChange();
  }

  MACRO OnContentsDirty() {
    IF(NOT ^contentsdirty->dirty)
      RETURN;

    ^contentsdirty->ClearDirty();
    this->SetDirty();
    this->OnValueChange();
  }

  MACRO OnValueChange() {
    IF(this->suspendonchange)
      RETURN;

    RECORD value := this->GetValue();
    IF(EncodeHSON(value) = EncodeHSON(this->lastnotifiedvalue))
      RETURN;

    this->lastnotifiedvalue := value;
    IF(this->onchange != DEFAULT MACRO PTR)
      this->onchange();
  }

  MACRO ConvertLinkType() {
    IF (^linktype->value = 2 AND this->current_linktype = 1)
    { // Try to convert internal links to external links
      //LookupPublisherURL would resolve a cached attachment to the document storing it, which isn't the file we were linking to
      IF (this->external->value != "" AND NOT IsCachedAttachmentLink(this->external->value))
      {
        //fill from external
        RECORD match := LookupPublisherURL(this->external->value);
        INTEGER matchid := match.file ?? match.folder;

        IF(matchid != 0)
        {
          this->internal->value := matchid;
          STRING baseurl := SELECT AS STRING indexurl FROM system.fs_objects WHERE id = matchid;
          IF (baseurl = "" OR Left(this->external->value, Length(baseurl)) != baseurl OR Substring(this->external->value, Length(baseurl), 1) NOT IN whconstant_internallink_startcharacters)
            baseurl := SELECT AS STRING objecturl FROM system.fs_objects WHERE id = matchid;

          IF (baseurl != "" AND Left(this->external->value, Length(baseurl)) = baseurl AND Substring(this->external->value, Length(baseurl), 1) IN whconstant_internallink_startcharacters)
            this->append->value := Substring(this->external->value, Length(baseurl));

          this->external->value := "";
        }
      }
    }
    ELSE IF (^linktype->value = 1 AND this->current_linktype = 2) //From internal to external
    {
      RECORD intextlink := this->GetCurrentInternalLinkValue();
      IF(RecordExists(intextlink))
      {
        // Not using GetIntextlinkTarget, because that returns '' when for a folder without index document
        // (because it uses indexurl instead of url)
        STRING exturl := SELECT AS STRING objecturl FROM system.fs_objects WHERE id = intextlink.internallink AND isactive;
        this->external->value := __MergeIntlinkAppend(exturl, intextlink.append);
      }

      this->internal->value := 0;
      this->append->value := "";
    }

    IF (this->current_linktype != ^linktype->value)
    {
      this->current_linktype := ^linktype->value;
      this->SetDirty();
    }
  }

  // ---------------------------------------------------------------------------
  //
  // Public API
  //

  PUBLIC UPDATE MACRO ValidateValue(OBJECT work)
  {
    STRING fieldtitle := this->errorlabel ?? this->title;
    IF(NOT this->enabled) //nothing to check on inactive fields
      RETURN;

    IF(this->required AND ^linktype->value = 0)
    {
      work->AddErrorFor(this, GetTid("tollium:common.errors.field_required", fieldtitle));
    }
    ELSE IF(^linktype->value = 2)
    {
      this->internal->ValidateValue(work);
      IF (Left(this->append->value, 1) NOT IN STRING[ "", ...whconstant_internallink_startcharacters ])
      {
        work->AddErrorFor(this, GetTid("publisher:components.errors.invalidappend", fieldtitle));
      }
      ELSE
      {
        STRING url := GetIntextlinkTarget(this->GetValue());
        IF(url != "")
        {
          STRING validate_error := ValidateInput(url, fieldtitle, [ "url" ]);
          IF (validate_error != "")
            work->AddErrorFor(this, validate_error);
        }
      }
    }
    ELSE IF(^linktype->value = 1)
    {
      ^external->ValidateValue(work);
      IF(^external->value != this->acceptedexternallink) {
        STRING validate_error := GetWebHareInternalLinkError(^external->value, fieldtitle);
        IF(validate_error != "")
          work->AddErrorFor(this, validate_error);
      }
    }
  }

  /** Preselect internal or external link */
  PUBLIC MACRO SetLinkType(STRING type)
  {
    IF(type = "internal")
      ^linktype->value := 2;
    ELSE IF(type = "external")
      ^linktype->value := 1;
    ELSE
      THROW NEW TolliumException(this, `Unrecognized SetLinkType value '${type}'`);
  }

  /** Focus the external link entry. Used by RTE to autofocus the most likely spot (at least for keyboard entry) on new links */
  PUBLIC MACRO FocusExternalLinkEntry()
  {
    IF(^linktype->value = 1)
      this->owner->frame->focused := ^external;
  }
>;
